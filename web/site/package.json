{
  "name": "@adage/site",
  "private": true,
  "version": "0.0.0",
  "description": "The public Adage website: the teaser film, the 3D hero and the landing page (deployed on Vercel)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "media": "node scripts/media.mjs",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:api": "node --experimental-strip-types --test scripts/waitlist.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/three": "0.186.0",
    "@vercel/blob": "^2.8.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
