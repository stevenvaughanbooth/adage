  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Bricolage Grotesque",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Headlines and big numbers (web). Weight 600-700, tracking -0.03em."
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Hanken Grotesk",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Explanation and UI (web). Weight 300 for body, 400-500 for UI."
    },
    "mono": {
