  "duration": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      },
      "$description": "Hover and press."
    },
    "base": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      },
      "$description": "Panels and toasts."
    },
    "pulse": {
      "$type": "duration",
      "$value": {
        "value": 900,
        "unit": "ms"
      },
      "$description": "A firing reflex's pulse, once."
    },
    "rise": {
      "$type": "duration",
      "$value": {
        "value": 800,
        "unit": "ms"
      },
      "$description": "A headline rising through a mask."
    }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": [
        0.25,
        1,
        0.5,
        1
      ],
      "$description": "Quartic ease-out."
    }
  },
  "glyph": {
    "$description": "Terminal glyphs, each with an ASCII fallback for terminals without UTF-8.",
    "lamp": {
      "$value": "●",
      "$description": "A strength lamp.",
      "$extensions": {
        "adage.ascii": "*"
      }
    },
    "off": {
      "$value": "○",
      "$description": "Nascent, not configured, or withheld.",
      "$extensions": {
        "adage.ascii": "o"
      }
    },
    "instinct": {
      "$value": "◉",
      "$description": "An instinct: born with it.",
      "$extensions": {
        "adage.ascii": "(o)"
      }
    },
    "reflex": {
      "$value": "◠",
      "$description": "A reflex: the learned arc.",
      "$extensions": {
        "adage.ascii": "~"
      }
    },
    "ok": {
      "$value": "✓",
      "$description": "Done, followed, met.",
      "$extensions": {
        "adage.ascii": "+"
      }
    },
    "fail": {
      "$value": "✗",
      "$description": "Failed.",
      "$extensions": {
        "adage.ascii": "x"
      }
    },
    "arrow": {
      "$value": "→",
      "$description": "Directs to.",
      "$extensions": {
        "adage.ascii": "->"
      }
    },
    "active": {
      "$value": "◆",
      "$description": "The active step.",
      "$extensions": {
        "adage.ascii": "*"
      }
    },
    "done": {
      "$value": "◇",
      "$description": "A finished step.",
      "$extensions": {
        "adage.ascii": "+"
      }
    },
    "rail": {
      "$value": "│",
      "$description": "The flow rail.",
      "$extensions": {
        "adage.ascii": "|"
      }
    },
    "pointer": {
      "$value": "›",
      "$description": "The selected choice.",
      "$extensions": {
        "adage.ascii": ">"
      }
    },
    "sep": {
      "$value": "·",
      "$description": "Separator between facts.",
      "$extensions": {
        "adage.ascii": "-"
      }
    },
    "card": {
      "$value": "▤",
      "$description": "A procedure card: the steps and files of a recurring task.",
      "$extensions": {
        "adage.ascii": "[=]"
      }
    },
    "rewrite": {
      "$value": "↪",
      "$description": "A rewrite: the command was changed before it ran.",
      "$extensions": {
        "adage.ascii": "=>"
      }
    },
    "quiet": {
      "$value": "◌",
      "$description": "Quiet: uplift below the bar; waits for a person.",
      "$extensions": {
        "adage.ascii": "(.)"
      }
    },
    "skill": {
      "$value": "◈",
      "$description": "From a skill (`adage train`).",
      "$extensions": {
        "adage.ascii": "<>"
      }
    },
    "notice": {
      "$value": "»",
      "$description": "A notice: the one line shown at session start.",
      "$extensions": {
        "adage.ascii": ">>"
      }
    }
  }
