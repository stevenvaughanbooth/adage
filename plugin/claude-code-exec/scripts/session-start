#!/bin/sh
# The retired adage-exec plugin, kept for one release as an alias (plan A8): the adage plugin now
# ships adage-exec beside adage and runs it itself while execution is on, so this plugin registers
# this SessionStart and nothing else. It points a stale ${CLAUDE_PLUGIN_DATA}/bin/adage-exec (left
# by an earlier version, whose hooks ran it) at scripts/quiet, so nothing an earlier version
# registered can answer an event twice, and says once per session start, as a JSON
# `systemMessage` on stdout, that the person can uninstall it. It runs no binary and records
# nothing. Every path exits 0.
ROOT="$1"; DATA="$2"
cat >/dev/null
[ -n "$ROOT" ] && [ -n "$DATA" ] || exit 0
if mkdir -p "$DATA/bin" 2>/dev/null; then
  ln -sfn "$ROOT/scripts/quiet" "$DATA/bin/adage-exec" 2>/dev/null
  # Windows copies were made under .exe names; none of them may answer anything any more.
  rm -f "$DATA/bin/adage-exec.exe" "$DATA/bin/adage.exe" 2>/dev/null
fi
printf '{"systemMessage":"%s"}\n' "adage-exec: the adage plugin now includes execution; uninstall this one (/plugin uninstall adage-exec@adage)."
exit 0
