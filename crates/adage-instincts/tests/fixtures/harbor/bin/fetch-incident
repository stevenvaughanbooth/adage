#!/usr/bin/env node
import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { inflateSync } from "node:zlib";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const args = process.argv.slice(2);
const asJson = args.includes("--json");
const id = args.find((a) => !a.startsWith("-"));

if (!id) {
  console.error("usage: fetch-incident <INC-id> [--json]");
  process.exit(2);
}

function load() {
  const buf = readFileSync(join(root, ".ops", "incidents.pack"));
  if (buf.subarray(0, 4).toString("latin1") !== "HDQ1") {
    throw new Error("fetch-incident: unreadable incident pack");
  }
  return JSON.parse(inflateSync(buf.subarray(4)).toString("utf8"));
}

const key = id.trim().toUpperCase();
const incident = load().find((x) => x.id === key);
if (!incident) {
  console.error(`fetch-incident: no incident ${key} in the ops queue`);
  process.exit(1);
}

if (asJson) {
  console.log(JSON.stringify(incident, null, 2));
} else {
  const wrap = (text, width = 88) => {
    const out = [];
    let line = "";
    for (const word of text.split(/\s+/)) {
      if (line && line.length + word.length + 1 > width) {
        out.push(line);
        line = word;
      } else {
        line = line ? `${line} ${word}` : word;
      }
    }
    if (line) out.push(line);
    return out;
  };
  const out = [
    `${incident.id}  ${incident.title}`,
    `status: ${incident.status}   priority: ${incident.priority}   area: ${incident.area}   reported: ${incident.reported} by ${incident.reporter}`,
    "",
    ...wrap(incident.description),
    "",
    "Acceptance:",
    ...wrap(incident.acceptance).map((l) => `  ${l}`),
    "",
    "Files:",
    ...incident.files.map((f) => `  ${f}`),
  ];
  console.log(out.join("\n"));
}
