.DS_Store
node_modules/
target/
.venv/
__pycache__/
*.onnx
*.safetensors
*.bin
spikes/**/models/
spikes/**/sandbox/
spikes/**/.cache/
.claude/settings.local.json
spikes/**/local/
spikes/**/cfg/
spikes/S6-ssh-signing/keys/
.claude/
plugin/claude-code/dist/
plugin/claude-code-exec/dist/
*.egg-info/
demo/results/*/raw/
web/map/dist/
web/map/test-results/
web/map/playwright-report/
web/map/review-shots/
# The bundled embedding model (MIT, SHA-256 pinned in adage-intent/src/model.rs) is source.
!crates/adage-intent/bundled/*.safetensors
*.snap.new

# Raw eval run output is never committed (evals/README.md, "Data policy"). Runners write here or
# to /tmp; curated evidence and test fixtures inside these directories are added with `git add -f`.
evals/**/results/
evals/showcase/live/
evals/showcase/dryrun/
evals/launch/go-validation/live/
demo/results/
spikes/**/results/
*.log
