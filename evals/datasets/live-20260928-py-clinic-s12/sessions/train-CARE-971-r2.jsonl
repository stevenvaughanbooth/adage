{"cwd": "/sandbox/runs/py-clinic-s12/runs/train-CARE-971-r2/wardline-clinic", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env python3\n2\t\"\"\"Look up an item in the case system.\n3\t\n4\t  case <ID> [--json]\n5\t\"\"\"\n6\timport json\n7\timport sys\n8\timport textwrap\n9\timport zlib\n10\tfrom pathlib import Path\n11\t\n12\tSTORE = Path(__file__).resolve().parents[1] / \".cases/store.dat\"\n13\tMAGIC = b\"WLC1\"\n14\t\n15\t\n16\tdef load():\n17\t    data = STORE.read_bytes()\n18\t    if data[:4] != MAGIC:\n19\t        sys.exit(\"case: unreadable store\")\n20\t    return json.loads(zlib.decompress(data[4:]))\n21\t\n22\t\n23\tdef render(item):\n24\t    wrap = lambda s: textwrap.wrap(s, 88) or [\"\"]  # noqa: E731\n25\t    out = [f\"{item['id']}  {item['title']}\",\n26\t           f\"status: {item['status']}   priority: {item['priority']}   area: {item['area']}   \"\n27\t           f\"reported: {item['reported']} by {item['reporter']}\", \"\"]\n28\t    out += wrap(item[\"description\"])\n29\t    out += [\"\", \"Acceptance:\"] + [f\"  {x}\" for x in wrap(item[\"acceptance\"])]\n30\t    out += [\"\", \"Files:\"] + ([f\"  {f}\" for f in item[\"files\"]] or [\"  (none)\"])\n31\t    return \"\\n\".join(out)\n32\t\n33\t\n34\tdef main(argv):\n35\t    ids = [a for a in argv if not a.startswith(\"-\")]\n36\t    if len(ids) != 1:\n37\t        print(\"usage: case <ID> [--json]\", file=sys.stderr)\n38\t        return 2\n39\t    key = ids[0].strip().upper()\n40\t    item = next((x for x in load() if x[\"id\"] == key), None)\n41\t    if item is None:\n42\t        print(f\"case: no item {key} in the case system\", file=sys.stderr)\n43\t        return 1\n44\t    print(json.dumps(item, indent=2, sort_keys=True) if \"--json\" in argv else render(item))\n45\t    return 0\n46\t\n47\t\n48\tif __name__ == \"__main__\":\n49\t    sys.exit(main(sys.argv[1:]))\n50\t", "is_error": false, "tool_use_id": "toolu_01WfzAR9YHToNE3emTE1YUrD", "type": "tool_result"}], "ro