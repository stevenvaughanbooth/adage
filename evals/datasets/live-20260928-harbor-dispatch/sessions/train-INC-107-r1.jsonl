{"cwd": "/sandbox/runs/harbor-dispatch/runs/train-INC-107-r1/harbor-dispatch", "isSidechain": false, "message": {"content": [{"content": "1\timport assert from \"node:assert/strict\";\n2\timport { describe, test } from \"node:test\";\n3\timport { berthsFor, fitsBerth } from \"@harbor/dispatch/berths/fit\";\n4\timport { BerthSchedule } from \"@harbor/dispatch/berths/schedule\";\n5\timport type { Berth, VesselClass } from \"@harbor/dispatch/types\";\n6\t\n7\tconst vessel: VesselClass = { name: \"Test\", lengthM: 300, beamM: 40, draftM: 12, teu: 8000 };\n8\tconst berth = (id: string, lengthM: number, depthM: number): Berth => ({ id, port: \"NLRTM\", lengthM, depthM });\n9\tconst at = (hhmm: string) => new Date(`2026-05-04T${hhmm}:00Z`);\n10\t\n11\tdescribe(\"berth fit\", () => {\n12\t  test(\"a vessel longer than the berth does not fit\", () => {\n13\t    assert.equal(fitsBerth(vessel, berth(\"B1\", 280, 16)), false);\n14\t  });\n15\t\n16\t  test(\"a deep, long berth fits\", () => {\n17\t    assert.equal(fitsBerth(vessel, berth(\"B2\", 350, 16)), true);\n18\t  });\n19\t\n20\t  test(\"candidate berths, shortest first\", () => {\n21\t    const got = berthsFor(vessel, [berth(\"B3\", 400, 17), berth(\"B1\", 280, 16), berth(\"B2\", 350, 16)]);\n22\t    assert.deepEqual(got.map((b) => b.id), [\"B2\", \"B3\"]);\n23\t  });\n24\t});\n25\t\n26\tdescribe(\"berth schedule\", () => {\n27\t  test(\"overlapping bookings on one berth are refused\", () => {\n28\t    const s = new BerthSchedule();\n29\t    s.book({ berth: \"B1\", vessel: \"MSC Ada\", start: at(\"08:00\"), end: at(\"12:00\") });\n30\t    assert.throws(() => s.book({ berth: \"B1\", vessel: \"Maersk Iva\", start: at(\"10:00\"), end: at(\"14:00\") }));\n31\t  });\n32\t\n33\t  test(\"other berths are independent\", () => {\n34\t    const s = new BerthSchedule();\n35\t    s.book({ berth: \"B1\", vessel: \"MSC Ada\", start: at(\"08:00\"), end: at(\"12:00\") });\n36\t    s.book({ berth: \"B2\", vessel: \"Maersk Iva\", start: at