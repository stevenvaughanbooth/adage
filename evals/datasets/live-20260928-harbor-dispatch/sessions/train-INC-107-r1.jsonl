,\n46\t    country: r.country.toUpperCase(),\n47\t    timezone: r.timezone,\n48\t    maxDraftM: num(\"registry/ports.csv\", r, \"max_draft_m\"),\n49\t    pilotageHours: num(\"registry/ports.csv\", r, \"pilotage_hours\"),\n50\t  }))\n51\t  .sort((a, b) => a.code.localeCompare(b.code));\n52\t\n53\tconst vessels = readCsv(\"registry/vessels.csv\", [\"class\", \"length_m\", \"beam_m\", \"draft_m\", \"teu\"])\n54\t  .map((r) => ({\n55\t    name: r.class,\n56\t    lengthM: num(\"registry/vessels.csv\", r, \"length_m\"),\n57\t    beamM: num(\"registry/vessels.csv\", r, \"beam_m\"),\n58\t    draftM: num(\"registry/vessels.csv\", r, \"draft_m\"),\n59\t    teu: num(\"registry/vessels.csv\", r, \"teu\"),\n60\t  }))\n61\t  .sort((a, b) => a.lengthM - b.lengthM || a.name.localeCompare(b.name));\n62\t\n63\tconst seen = new Set();\n64\tfor (const p of ports) {\n65\t  if (seen.has(p.code)) fail(`registry/ports.csv: duplicate code ${p.code}`);\n66\t  seen.add(p.code);\n67\t}\n68\t\n69\tconst lines = [\n70\t  'import type { Port, VesselClass } from \"../types.ts\";',\n71\t  \"\",\n72\t  \"export const PORTS: readonly Port[] = [\",\n73\t  ...ports.map(\n74\t    (p) =>\n75\t      `  { code: ${str(p.code)}, name: ${str(p.name)}, country: ${str(p.country)}, timezone: ${str(p.timezone)}, maxDraftM: ${p.maxDraftM}, pilotageHours: ${p.pilotageHours} },`,\n76\t  ),\n77\t  \"];\",\n78\t  \"\n[... 759 characters trimmed by build_demo.py]", "is_error": false, "tool_use_id": "toolu_015TMKTC4WrmtBAwpGyqpsAq", "type": "tool_result"}], "role": "user"}, "sessionId": "c89d9e40-6dd1-4fad-be75-ab9376bb8afa", "timestamp": "2026-09-28T03:34:10.242Z", "toolUseResult": {}, "type": "user"}
