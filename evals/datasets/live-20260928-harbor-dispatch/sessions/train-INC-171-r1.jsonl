{"cwd": "/sandbox/runs/harbor-dispatch/runs/train-INC-171-r1/harbor-dispatch", "isSidechain": false, "message": {"content": [{"content": "1\timport assert from \"node:assert/strict\";\n2\timport { describe, test } from \"node:test\";\n3\timport { countryOf, isValidLocode, normaliseLocode } from \"@harbor/dispatch/ports/locode\";\n4\timport { classesForPort, portByCode, portsInCountry, vesselClass } from \"@harbor/dispatch/ports/registry\";\n5\t\n6\tdescribe(\"locode\", () => {\n7\t  test(\"case is normalised\", () => {\n8\t    assert.equal(normaliseLocode(\" nlrtm \"), \"NLRTM\");\n9\t    assert.equal(isValidLocode(\"sgsin\"), true);\n10\t  });\n11\t\n12\t  test(\"malformed codes are invalid\", () => {\n13\t    assert.equal(isValidLocode(\"NL\"), false);\n14\t    assert.throws(() => countryOf(\"12345\"), RangeError);\n15\t  });\n16\t\n17\t  test(\"country\", () => {\n18\t    assert.equal(countryOf(\"DEHAM\"), \"DE\");\n19\t  });\n20\t});\n21\t\n22\tdescribe(\"registry\", () => {\n23\t  test(\"ports by code\", () => {\n24\t    assert.equal(portByCode(\"nlrtm\")?.name, \"Rotterdam\");\n25\t    assert.equal(portByCode(\"XXZZZ\"), undefined);\n26\t  });\n27\t\n28\t  test(\"ports by country\", () => {\n29\t    assert.deepEqual(portsInCountry(\"us\").map((p) => p.code), [\"USLAX\", \"USNYC\"]);\n30\t  });\n31\t\n32\t  test(\"vessel classes\", () => {\n33\t    assert.equal(vesselClass(\"panamax\")?.teu, 5000);\n34\t    const hamburg = portByCode(\"DEHAM\");\n35\t    assert.ok(hamburg);\n36\t    assert.equal(classesForPort(hamburg).some((v) => v.name === \"ULCV\"), false);\n37\t  });\n38\t});\n39\t", "is_error": false, "tool_use_id": "toolu_01H4xqXtdYD32xqEBf8VPGJe", "type": "tool_result"}], "role": "user"}, "sessionId": "4f2a2908-cea9-462e-ad53-1d2edb6f6d1d", "timestamp": "2026-09-28T03:35:35.337Z", "toolUseResult": {}, "type": "user"}
