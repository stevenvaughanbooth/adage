barray(0, 4).toString(\"latin1\") !== \"HDQ1\") {\n+    throw new Error(\"fetch-incident: unreadable incident pack\");\n+  }\n+  return JSON.parse(inflateSync(buf.subarray(4)).toString(\"utf8\"));\n+}\n+\n+const key = id.trim().toUpperCase();\n+const incident = load().find((x) => x.id === key);\n+if (!incident) {\n+  console.error(`fetch-incident: no incident ${key} in the ops queue`);\n+  process.exit(1);\n+}\n+\n+if (asJson) {\n+  console.log(JSON.stringify(incident, null, 2));\n+} else {\n+  const wrap = (text, width = 88) => {\n+    const out = [];\n+    let line = \"\";\n+    for (const word of text.split(/\\s+/)) {\n+      if (line && line.length + word.length + 1 > width) {\n+        out.push(line);\n+        line = word;\n+      } else {\n+        line = line ? `${line} ${word}` : word;\n+      }\n+    }\n+    if (line) out.push(line);\n+    return out;\n+  };\n+  const out = [\n+    `${incident.id}  ${incident.title}`,\n+    `status: ${incident.status}   priority: ${incident.priority}   area: ${incident.area}   reported: ${incident.reported} by ${incident.reporter}`,\n+    \"\",\n+    ...wrap(incident.description),\n+    \"\",\n+    \"Acceptance:\",", "is_error": false, "tool_use_id": "toolu_01QXz35DaTWe93Ze7hWdYo4B", "type": "tool_result"}], "role": "user"}, "sessionId": "367c3c6a-9087-4a31-8749-b79e18a46ab1", "timestamp": "2026-09-28T03:37:07.794Z", "toolUseResult": {"stdout": "commit 5241fbdd2d8b91edba5d5f62bca682c7996fb2f2\nAuthor: Harbor Ops <ops@harbor.example>\nDate:   Sun Sep 20 09:00:00 2026 +0000\n\n    harbor-dispatch 3.4.0\n\ndiff --git a/.gitignore b/.gitignore\nnew file mode 100644\nindex 0000000..3c45938\n--- /dev/null\n+++ b/.gitignore\n@@ -0,0 +1,3 @@\n+node_modules/\n+*.log\n+.DS_Store\ndiff --git a/.nvmrc b/.nvmrc\nnew file mode 100644\nindex 0000000..6f4247a\n--- /dev/null\n+++ b/.nvmrc\n@@ -0,0 +1 @@\n+26\ndiff --git a/.ops/incidents.pack b/.ops/incidents.pack\nnew file mode 100644\nindex 0000000..bb29ec9\nBinary files /dev/null and b/.