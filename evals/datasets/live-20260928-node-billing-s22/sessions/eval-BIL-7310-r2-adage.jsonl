e];\n41\t      const fields = Object.keys(rec).sort().map((k) => `${JSON.stringify(k)}: ${JSON.stringify(rec[k])}`).join(\", \");\n42\t      out.push(`    ${JSON.stringify(code)}: Object.freeze({ ${fields} }),`);\n43\t    }\n44\t    out.push(\"  }),\");\n45\t  }\n46\t  out.push(\"});\", \"\");\n47\t  return out.join(\"\\n\");\n48\t}\n49\t\n50\tconst text = render();\n51\tconst target = join(root, OUT);\n52\tif (args.includes(\"--verify\")) {\n53\t  if (!existsSync(target) || readFileSync(target, \"utf8\") !== text) {\n54\t    console.error(`error: ${OUT} is out of date with registry/*.csv, run npm run codegen`);\n55\t    process.exit(1);\n56\t  }\n57\t} else {\n58\t  writeFileSync(target, text);\n59\t  console.log(`wrote ${OUT}`);\n60\t}\n61\t", "is_error": false, "tool_use_id": "toolu_01H8nPFDAnw2QKCTHN5xrGsZ", "type": "tool_result"}], "role": "user"}, "sessionId": "48bb136b-51f9-421a-b676-af56d69951ca", "timestamp": "2026-09-28T03:48:28.701Z", "toolUseResult": {}, "type": "user"}
