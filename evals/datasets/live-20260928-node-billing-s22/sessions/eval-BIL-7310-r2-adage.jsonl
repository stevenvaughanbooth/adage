"--json\")) {\n52\t  console.log(JSON.stringify(sortKeys(item), null, 2));\n53\t} else {\n54\t  const out = [\n55\t    `${item.id}  ${item.title}`,\n56\t    `status: ${item.status}   priority: ${item.priority}   area: ${item.area}   reported: ${item.reported} by ${item.reporter}`,\n57\t    \"\",\n58\t    ...wrap(item.description),\n59\t    \"\",\n60\t    \"Acceptance:\",\n61\t    ...wrap(item.acceptance).map((l) => `  ${l}`),\n62\t    \"\",\n63\t    \"Files:\",\n64\t    ...(item.files.length ? item.files.map((f) => `  ${f}`) : [\"  (none)\"]),\n65\t  ];\n66\t  console.log(out.join(\"\\n\"));\n67\t}\n68\t", "is_error": false, "tool_use_id": "toolu_013EwPr3TsXAQpzE6z6yi4zS", "type": "tool_result"}], "role": "user"}, "sessionId": "48bb136b-51f9-421a-b676-af56d69951ca", "timestamp": "2026-09-28T03:48:16.522Z", "toolUseResult": {}, "type": "user"}
