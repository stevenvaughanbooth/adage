{"cwd": "/sandbox/runs/py-logistics-s13/runs/eval-OPS-74-r1-holdout/portside-dispatch", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env python3\n2\t\"\"\"Generate portside/generated/registry.py from registry/*.csv.\n3\t\n4\t  python3 tools/gen.py                 write it\n5\t  python3 tools/gen.py --check         fail if it is out of date\n6\t  python3 tools/gen.py --root DIR      work on another checkout\n7\t\"\"\"\n8\timport sys\n9\tfrom pathlib import Path\n10\t\n11\tOUT = \"portside/generated/registry.py\"\n12\t\n13\t\n14\tdef parse(text):\n15\t    lines = [line for line in text.splitlines() if line.strip()]\n16\t    header = [h.strip() for h in lines[0].split(\",\")]\n17\t    rows = {}\n18\t    for line in lines[1:]:\n19\t        cells = [c.strip() for c in line.split(\",\")]\n20\t        cells += [\"\"] * (len(header) - len(cells))\n21\t        rows[cells[0].upper()] = {h: (int(v) if v.isdigit() else v) for h, v in zip(header, cells) if h != \"code\"}\n22\t    return rows\n23\t\n24\t\n25\tdef render(root):\n26\t    out = [\"# Generated by tools/gen.py from registry/*.csv. Do not edit by hand.\", \"\", \"TABLES = {\"]\n27\t    for path in sorted((Path(root) / \"registry\").glob(\"*.csv\")):\n28\t        rows = parse(path.read_text())\n29\t        out.append(f\"    {path.stem!r}: {{\")\n30\t        for code in sorted(rows):\n31\t            fields = \", \".join(f\"{k!r}: {rows[code][k]!r}\" for k in sorted(rows[code]))\n32\t            out.append(f\"        {code!r}: {{{fields}}},\")\n33\t        out.append(\"    },\")\n34\t    out += [\"}\", \"\"]\n35\t    return \"\\n\".join(out)\n36\t\n37\t\n38\tdef main(argv):\n39\t    root = Path(argv[argv.index(\"--root\") + 1]) if \"--root\" in argv else Path(__file__).resolve().parent.parent\n40\t    text = render(root)\n41\t    target = root / OUT\n42\t    if \"--check\" in argv:\n43\t        if not target.exists() or target.read_text() != text:\n44\t            print(f\"error: {OUT} is out of date with registry/*.csv, run 'make gen'\", file=sys.stderr)\n45\t            return 1\n46\t        return 0\n47\t    target.write_text(text)\n48\t    print(f\"wrote {OUT}\")\n49\t    return 0\n50\t\n51\t\n52\tif __name__ == \"__main__\":\n53\t    sys.exit(main(sys.argv[1:]))\n54\t", "is_error": false, "tool_use_id": "toolu_01F3YabdQsd58xsqJR5DrcBN", "type": "tool_result"}], "role": "user"}, "sessionId": "c7daf5d0-569c-40ac-81d7-f0ff62733428", "timestamp": "2026-09-28T03:41:32.507Z", "toolUseResult": {}, "type": "user"}
