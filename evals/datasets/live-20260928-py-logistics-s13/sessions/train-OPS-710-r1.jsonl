ef main(argv):\n    root = Path(argv[argv.index(\"--root\") + 1]) if \"--root\" in argv else Path(__file__).resolve().parent.parent\n    text = render(root)\n    target = root / OUT\n    if \"--check\" in argv:\n        if not target.exists() or target.read_text() != text:\n            print(f\"error: {OUT} is out of date with registry/*.csv, run 'make gen'\", file=sys.stderr)\n            return 1\n        return 0\n    target.write_text(text)\n    print(f\"wrote {OUT}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n\"\"\"Regenerate the protocol stubs. The stubs moved to the shared schema repository in 2025, so there is nothing left to generate here.\"\"\"\nprint(\"proto: no protocol files in this repository, nothing to generate\")\n#!/usr/bin/env python3\n\"\"\"Run the test suite with its fixtures loaded (what `make check` runs).\"\"\"\nimport builtins\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsetattr(builtins, \"__portside_testkit__\", True)\nsys.path.insert(0, ROOT)\nos.chdir(ROOT)\nsuite = unittest.defaultTestLoader.discover(\"tests\", top_level_dir=ROOT)\nresult = unittest.TextTestRunner(verbosity=2).run(suite)\nsys.exit(0 if result.wasSuccessful() else 1)", "is_error": false, "tool_use_id": "toolu_01WqCGCTD8ZBJCrJfrgVxm92", "type": "tool_result"}], "role": "user"}, "sessionId": "c8f83cc3-e43a-4df8-bd4d-d5ee28920d68", "timestamp": "2026-09-28T03:38:31.767Z", "toolUseResult": {"stdout": "total 24\ndrwxr-xr-x  2 root root 4096 Sep 28 03:37 .\ndrwxr-xr-x 10 root root 4096 Sep 28 03:37 ..\n-rw-r--r--  1 root root  165 Sep 28 03:37 bench.py\n-rwxr-xr-x  1 root root 1823 Sep 28 03:37 gen.py\n-rw-r--r--  1 root root  211 Sep 28 03:37 proto.py\n-rwxr-xr-x  1 root root  483 Sep 28 03:37 testkit.py\n\"\"\"Micro-benchmarks for the hot helpers (kept for release notes).\"\"\"\nimport timeit\n\nn = timeit.timeit(\"sum(range(100))\", number=1000)\nprint(\"bench: 1000 ru