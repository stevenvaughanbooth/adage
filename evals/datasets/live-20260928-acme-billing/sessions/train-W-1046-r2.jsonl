{"cwd": "/sandbox/runs/acme-billing/runs/train-W-1046-r2/acme-billing", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env python3\n2\t\"\"\"Generate dataclass models from schema files.\"\"\"\n3\timport json\n4\tfrom pathlib import Path\n5\tfrom dataclasses import dataclass, field\n6\t\n7\tdef load_schema(path):\n8\t    with open(path) as f:\n9\t        return json.load(f)\n10\t\n11\tdef generate_models(check=False):\n12\t    schema_dir = Path(\"schema\")\n13\t    output = Path(\"acme/generated/models.py\")\n14\t\n15\t    lines = [\"from dataclasses import dataclass, field\"]\n16\t    lines.append(\"\")\n17\t\n18\t    for schema_file in sorted(schema_dir.glob(\"*.json\")):\n19\t        schema = load_schema(schema_file)\n20\t        name = schema_file.stem.capitalize()\n21\t        lines.append(f\"@dataclass\")\n22\t        lines.append(f\"class {name}:\")\n23\t        for field_name, field_def in schema.items():\n24\t            ftype = field_def[\"type\"]\n25\t            default = field_def.get(\"default\")\n26\t            if default is None:\n27\t                lines.append(f\"    {field_name}: {ftype}\")\n28\t            else:\n29\t                if isinstance(default, str):\n30\t                    default_repr = repr(default)\n31\t                else:\n32\t                    default_repr = default\n33\t                lines.append(f\"    {field_name}: {ftype} = {default_repr}\")\n34\t        lines.append(\"\")\n35\t\n36\t    text = \"\\n\".join(lines)\n37\t    if check:\n38\t        current = output.read_text() if output.exists() else \"\"\n39\t        if current != text:\n40\t            raise SystemExit(\"generated models are stale — run 'make gen'\")\n41\t        return\n42\t    output.write_text(text)\n43\t\n44\tif __name__ == \"__main__\":\n45\t    import sys\n46\t    generate_models(check=\"--check\" in sys.argv)\n47\t", "is_error": false, "tool_use_id": "toolu_01WqWUg4rAe9vKVmcfrk5Shx", "type": "tool_result"}], "role": "user"}, "sessionId": "78f1041a-0693-4a25-941c-00a5969de56a", "timestamp": "2026-09-28T03:37:03.651Z", "toolUseResult": {}, "type": "user"}
