(\"B\", 40), box(\"C\", 20, { reefer: true })]), 2);\n   });", "is_error": false, "tool_use_id": "toolu_01C7SvUAYgsfrTcF6StW8rN9", "type": "tool_result"}], "role": "user"}, "sessionId": "3f10461c-deda-4a30-ba2a-edabf05bf181", "timestamp": "2026-09-28T03:52:43.610Z", "toolUseResult": {"stdout": "diff --git a/src/cargo/manifest.ts b/src/cargo/manifest.ts\nindex cac52ff..26e3988 100644\n--- a/src/cargo/manifest.ts\n+++ b/src/cargo/manifest.ts\n@@ -21,7 +21,7 @@ export function verifiedGrossMassTonnes(container: Container): number {\n   if (container.cargoKg < 0 || container.tareKg < 0) {\n     throw new RangeError(`negative mass on ${container.id}`);\n   }\n-  return Math.round(container.cargoKg) / 1000;\n+  return Math.round(container.cargoKg + container.tareKg) / 1000;\n }\n \n export function manifestWeightTonnes(containers: readonly Container[]): number {\ndiff --git a/test/manifest.test.ts b/test/manifest.test.ts\nindex cc55997..9bae7dd 100644\n--- a/test/manifest.test.ts\n+++ b/test/manifest.test.ts\n@@ -1,6 +1,12 @@\n import assert from \"node:assert/strict\";\n import { describe, test } from \"node:test\";\n-import { manifestTeu, reeferCount, teuOf, verifiedGrossMassTonnes } from \"@harbor/dispatch/cargo/manifest\";\n+import {\n+  manifestTeu,\n+  manifestWeightTonnes,\n+  reeferCount,\n+  teuOf,\n+  verifiedGrossMassTonnes,\n+} from \"@harbor/dispatch/cargo/manifest\";\n import type { Container } from \"@harbor/dispatch/types\";\n \n const box = (id: string, lengthFt: 20 | 40 | 45, extra: Partial<Container> = {}): Container => ({\n@@ -27,6 +33,14 @@ describe(\"manifest\", () => {\n     assert.throws(() => verifiedGrossMassTonnes(box(\"A\", 20, { cargoKg: -1 })), RangeError);\n   });\n \n+  test(\"verified gross mass includes the container tare\", () => {\n+    assert.equal(verifiedGrossMassTonnes(box(\"A\", 20, { cargoKg: 20_000, tareKg: 2_200 })), 22.2);\n+    assert.equal(\n+      manifestWeightTonnes([box(\"A\", 20, { cargoKg: 20_000, tareKg: 2_200 })]),\n+