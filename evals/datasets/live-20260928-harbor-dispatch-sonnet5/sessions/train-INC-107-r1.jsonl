tart: at(\"10:00\"), end: at(\"14:00\") });\n37\t    assert.equal(s.bookingsFor(\"B2\").length, 1);\n38\t  });\n39\t\n40\t  test(\"a booking must end after it starts\", () => {\n41\t    const s = new BerthSchedule();\n42\t    assert.throws(() => s.book({ berth: \"B1\", vessel: \"MSC Ada\", start: at(\"12:00\"), end: at(\"08:00\") }), RangeError);\n43\t  });\n44\t});\n45\t", "is_error": false, "tool_use_id": "toolu_01JtJrLyu4FLQdL3vhT8Dzfo", "type": "tool_result"}], "role": "user"}, "sessionId": "ddb89207-ddb0-4c85-aec8-9f7527b747a2", "timestamp": "2026-09-28T03:40:34.063Z", "toolUseResult": {}, "type": "user"}
