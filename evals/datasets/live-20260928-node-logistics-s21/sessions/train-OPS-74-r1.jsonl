1\t      const fields = Object.keys(rec).sort().map((k) => `${JSON.stringify(k)}: ${JSON.stringify(rec[k])}`).join(\", \");\n42\t      out.push(`    ${JSON.stringify(code)}: Object.freeze({ ${fields} }),`);\n43\t    }\n44\t    out.push(\"  }),\");\n45\t  }\n46\t  out.push(\"});\", \"\");\n47\t  return out.join(\"\\n\");\n48\t}\n49\t\n50\tconst text = render();\n51\tconst target = join(root, OUT);\n52\tif (args.includes(\"--verify\")) {\n53\t  if (!existsSync(target) || readFileSync(target, \"utf8\") !== text) {\n54\t    console.error(`error: ${OUT} is out of date with registry/*.csv, run npm run codegen`);\n55\t    process.exit(1);\n56\t  }\n57\t} else {\n58\t  writeFileSync(target, text);\n59\t  console.log(`wrote ${OUT}`);\n60\t}\n61\t", "is_error": false, "tool_use_id": "toolu_01W37qEAYJR1Z5X1sypmZs2j", "type": "tool_result"}], "role": "user"}, "sessionId": "8980165a-8e43-488c-a84a-9d69a8b1a4c3", "timestamp": "2026-09-28T03:38:34.145Z", "toolUseResult": {}, "type": "user"}
