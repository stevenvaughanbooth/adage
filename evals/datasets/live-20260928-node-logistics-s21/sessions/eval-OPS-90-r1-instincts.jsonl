{"cwd": "/sandbox/runs/node-logistics-s21/runs/eval-OPS-90-r1-instincts/portside-dispatch", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env node\n2\t// Look up an item in the ops queue:  fetch-ticket <ID> [--json]\n3\timport { readFileSync } from \"node:fs\";\n4\timport { dirname, join } from \"node:path\";\n5\timport { fileURLToPath } from \"node:url\";\n6\timport { inflateSync } from \"node:zlib\";\n7\t\n8\tconst root = join(dirname(fileURLToPath(import.meta.url)), \"..\");\n9\tconst args = process.argv.slice(2);\n10\tconst ids = args.filter((a) => !a.startsWith(\"-\"));\n11\tif (ids.length !== 1) {\n12\t  console.error(\"usage: fetch-ticket <ID> [--json]\");\n13\t  process.exit(2);\n14\t}\n15\t\n16\tfunction load() {\n17\t  const buf = readFileSync(join(root, \".ops/queue.pack\"));\n18\t  if (buf.subarray(0, 4).toString(\"latin1\") !== \"PSQ1\") throw new Error(\"fetch-ticket: unreadable store\");\n19\t  return JSON.parse(inflateSync(buf.subarray(4)).toString(\"utf8\"));\n20\t}\n21\t\n22\tfunction wrap(text, width = 88) {\n23\t  const out = [];\n24\t  let line = \"\";\n25\t  for (const word of text.split(/\\s+/).filter(Boolean)) {\n26\t    if (line && line.length + word.length + 1 > width) {\n27\t      out.push(line);\n28\t      line = word;\n29\t    } else {\n30\t      line = line ? `${line} ${word}` : word;\n31\t    }\n32\t  }\n33\t  if (line) out.push(line);\n34\t  return out.length ? out : [\"\"];\n35\t}\n36\t\n37\tfunction sortKeys(value) {\n38\t  if (Array.isArray(value)) return value.map(sortKeys);\n39\t  if (value && typeof value === \"object\") {\n40\t    return Object.fromEntries(Object.keys(value).sort().map((k) => [k, sortKeys(value[k])]));\n41\t  }\n42\t  return value;\n43\t}\n44\t\n45\tconst key = ids[0].trim().toUpperCase();\n46\tconst item = load().find((x) => x.id === key);\n47\tif (!item) {\n48\t  console.error(`fetch-ticket: no item ${key} in the ops queue`);\n49\t  process.exit(1);\n50\t}\n51\tif (args.includes(\"-