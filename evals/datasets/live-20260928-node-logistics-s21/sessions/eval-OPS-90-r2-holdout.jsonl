{"cwd": "/sandbox/runs/node-logistics-s21/runs/eval-OPS-90-r2-holdout/portside-dispatch", "isSidechain": false, "message": {"content": [{"content": "1\t#!/usr/bin/env node\n2\t// Generates src/generated/registry.mjs from registry/*.csv.\n3\t//   node tools/codegen.mjs            write it\n4\t//   node tools/codegen.mjs --verify   fail if it is out of date\n5\t//   node tools/codegen.mjs --root DIR work on another checkout\n6\timport { existsSync, readFileSync, readdirSync, writeFileSync } from \"node:fs\";\n7\timport { dirname, join } from \"node:path\";\n8\timport { fileURLToPath } from \"node:url\";\n9\t\n10\tconst args = process.argv.slice(2);\n11\tconst at = args.indexOf(\"--root\");\n12\tconst root = at >= 0 ? args[at + 1] : join(dirname(fileURLToPath(import.meta.url)), \"..\");\n13\tconst OUT = \"src/generated/registry.mjs\";\n14\t\n15\tfunction parse(text) {\n16\t  const lines = text.split(/\\r?\\n/).filter((l) => l.trim() !== \"\");\n17\t  const header = lines[0].split(\",\").map((h) => h.trim());\n18\t  const rows = {};\n19\t  for (const line of lines.slice(1)) {\n20\t    const cells = line.split(\",\").map((c) => c.trim());\n21\t    const rec = {};\n22\t    header.forEach((h, i) => {\n23\t      const v = cells[i] ?? \"\";\n24\t      if (h !== \"code\") rec[h] = /^[0-9]+$/.test(v) ? Number(v) : v;\n25\t    });\n26\t    rows[cells[0].toUpperCase()] = rec;\n27\t  }\n28\t  return rows;\n29\t}\n30\t\n31\tfunction render() {\n32\t  const dir = join(root, \"registry\");\n33\t  const files = readdirSync(dir).filter((f) => f.endsWith(\".csv\")).sort();\n34\t  const out = [\"// Generated by tools/codegen.mjs from registry/*.csv. Do not edit by hand.\", \"\",\n35\t    \"export const TABLES = Object.freeze({\"];\n36\t  for (const f of files) {\n37\t    const rows = parse(readFileSync(join(dir, f), \"utf8\"));\n38\t    out.push(`  ${JSON.stringify(f.slice(0, -4))}: Object.freeze({`);\n39\t    for (const code of Object.keys(rows).sort()) {\n40\t      const rec = rows[code];\n41\t      const fields = Object.keys(rec).sort().map((k) => `${JSON.stringify(k)}: ${JSON.stringify(rec[k])}`).join(\", \");\n42\t      out.push(`    ${JSON.stringify(code)}: Object.freeze({ ${fields} }),`);\n43\t    }\n44\t    out.push(\"  }),\");\n45\t  }\n46\t  out.push(\"});\", \"\");\n47\t  return out.join(\"\\n\");\n48\t}\n49\t\n50\tconst text = render();\n51\tconst target = join(root, OUT);\n52\tif (args.includes(\"--verify\")) {\n53\t  if (!existsSync(target) || readFileSync(target, \"utf8\") !== text) {\n54\t    console.error(`error: ${OUT} is out of date with registry/*.csv, run npm run codegen`);\n55\t    process.exit(1);\n56\t  }\n57\t} else {\n58\t  writeFileSync(target, text);\n59\t  console.log(`wrote ${OUT}`);\n60\t}\n61\t", "is_error": false, "tool_use_id": "toolu_012UGrGtNKzHvG3GFJm9QtGD", "type": "tool_result"}], "role": "user"}, "sessionId": "fdc49442-587e-4d7b-99db-1451ef52f673", "timestamp": "2026-09-28T03:45:20.685Z", "toolUseResult": {}, "type": "user"}
