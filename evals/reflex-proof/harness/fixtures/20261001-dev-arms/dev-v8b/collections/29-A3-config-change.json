        "classification": "opaque_shell",
        "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nv = validate.Finite()\n\n# Test edge cases\ntest_cases = [\n    (0, True, \"zero\"),\n    (1, True, \"positive integer\"),\n    (-1, True, \"negative integer\"),\n    (1.5, True, \"positive float\"),\n    (-1.5, True, \"negative float\"),\n    (1e308, True, \"large positive number\"),\n    (-1e308, True, \"large negative number\"),\n    (float('inf'), False, \"positive infinity\"),\n    (float('-inf'), False, \"negative infinity\"),\n    (float('nan'), False, \"NaN\"),\n]\n\nfor value, should_pass, description in test_cases:\n    try:\n        result = v(value)\n        if should_pass:\n            print(f\"\u2713 {description}: {value} -> {result}\")\n        else:\n            print(f\"\u2717 {description}: {value} should have raised ValidationError\")\n    except ValidationError as e:\n        if not should_pass:\n            print(f\"\u2713 {description}: {value} raised ValidationError as expected\")\n        else:\n            print(f\"\u2717 {description}: {value} unexpectedly raised ValidationError: {e.messages}\")\nEOF\n",
