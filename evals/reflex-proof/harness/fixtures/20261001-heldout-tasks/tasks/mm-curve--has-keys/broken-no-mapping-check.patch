diff --git a/src/marshmallow/validate.py b/src/marshmallow/validate.py
index 35c0e8b..1e6b2d5 100644
--- a/src/marshmallow/validate.py
+++ b/src/marshmallow/validate.py
@@ -706,3 +706,31 @@ class ContainsNoneOf(NoneOf):
             if val in self.iterable:
                 raise ValidationError(self._format_error(value))
         return value
+
+
+class HasKeys(Validator):
+    """which succeeds if the input is a mapping (such as a `dict`) that contains every key in `keys`; extra keys are allowed, and input that is not a mapping fails.
+
+    :param error: Error message to raise in case of a validation error.
+    """
+
+    default_message = 'Missing required keys.'
+
+    def __init__(self, keys, *, error: str | None = None):
+        self.keys = keys
+        self.error: str = error or self.default_message
+
+    def _repr_args(self) -> str:
+        return f"keys={self.keys!r}"
+
+    def _format_error(self, value) -> str:
+        return self.error.format(input=value, keys=self.keys)
+
+    def __call__(self, value):
+        try:
+            ok = all(k in value for k in self.keys)
+        except (TypeError, ValueError):
+            ok = False
+        if not ok:
+            raise ValidationError(self._format_error(value))
+        return value
