   "command": ".venv/bin/python << 'EOF'\n# Test that Finite is accessible from marshmallow.validate\nfrom marshmallow.validate import Finite\nprint(f\"Finite imported successfully: {Finite}\")\nprint(f\"Finite.__doc__[:50]: {Finite.__doc__[:50]}\")\n\n# Verify the example from the docstring works\nfrom marshmallow import validate, ValidationError\n\nvalidator = validate.Finite()\nprint(f\"validator(0) = {validator(0)}\")  # Valid\nprint(f\"validator(1.5) = {validator(1.5)}\")  # Valid\ntry:\n    validator(float('inf'))  # ValidationError: Must satisfy Finite.\nexcept ValidationError as e:\n    print(f\"validator(float('inf')) raised: {e}\")\nEOF\n",
