  {
   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\nimport math\n\n# Test valid inputs\nv = validate.Finite()\nprint(\"Valid inputs:\")\nprint(f\"v(0) = {v(0)}\")\nprint(f\"v(1) = {v(1)}\")\nprint(f\"v(-1) = {v(-1)}\")\nprint(f\"v(1.5) = {v(1.5)}\")\nprint(f\"v(1e10) = {v(1e10)}\")\n\n# Test invalid inputs\nprint(\"\\nInvalid inputs:\")\ninvalid_values = [float('nan'), float('inf'), float('-inf')]\nfor val in invalid_values:\n    try:\n        v(val)\n        print(f\"ERROR: v({val}) should have raised ValidationError\")\n    except ValidationError as e:\n        print(f\"v({val}) raised: {e}\")\n\n# Test custom error message\nprint(\"\\nCustom error message:\")\nv_custom = validate.Finite(error=\"Value {input} must be finite\")\ntry:\n    v_custom(float('inf'))\nexcept ValidationError as e:\n    print(f\"Custom error: {e}\")\n\n# Test repr\nprint(f\"\\nRepr: {repr(v)}\")\nprint(f\"Repr with error: {repr(v_custom)}\")\n\n# Test 1e309 (the example from the requirement)\nprint(\"\\nEdge case: 1e309\")\ntry:\n    v(1e309)\n    print(f\"1e309 is considered valid (it's a float: {1e309})\")\nexcept ValidationError as e:\n    print(f\"1e309 raised: {e}\")\n\n# Test what 1e309 actually is\nprint(f\"\\nmath.isfinite(1e309) = {math.isfinite(1e309)}\")\nprint(f\"1e309 = {1e309}\")\nprint(f\"1e309 == float('inf') = {1e309 == float('inf')}\")\nEOF\n",
