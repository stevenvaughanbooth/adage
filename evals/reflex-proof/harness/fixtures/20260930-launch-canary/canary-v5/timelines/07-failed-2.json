   "adage_pre_context": false,
   "command": ".venv/bin/python -c \"\nfrom marshmallow import validate, ValidationError\n\n# Test valid input\nv = validate.Finite()\nprint('Valid inputs:')\nprint('  0:', v(0))\nprint('  1:', v(1))\nprint('  -1:', v(-1))\nprint('  3.14:', v(3.14))\n\n# Test invalid input - 1e309 is a very large number (close to infinity)\nprint('\\nInvalid inputs:')\ntry:\n    v(float('nan'))\n    print('  NaN: Should have failed!')\nexcept ValidationError as e:\n    print('  NaN: Failed as expected')\n\ntry:\n    v(float('inf'))\n    print('  inf: Should have failed!')\nexcept ValidationError as e:\n    print('  inf: Failed as expected')\n\ntry:\n    v(float('-inf'))\n    print('  -inf: Should have failed!')\nexcept ValidationError as e:\n    print('  -inf: Failed as expected')\n\n# 1e309 is actually representable as infinity\nprint('\\nLarge number test:')\nprint('  1e308:', v(1e308))  # Very large but still finite\ntry:\n    v(float('1e309'))  # This becomes inf\n    print('  1e309: Should have failed!')\nexcept ValidationError:\n    print('  1e309 (inf): Failed as expected')\n\n# Test custom error message\nprint('\\nCustom error message:')\nv2 = validate.Finite(error='{input} is not finite')\ntry:\n    v2(float('nan'))\nexcept ValidationError as e:\n    print('  Error message:', str(e))\n\"\n",
