   "command": ".venv/bin/python -c \"\nfrom marshmallow import validate, ValidationError\nimport math\n\n# Test valid finite numbers\nv = validate.Finite()\nprint('Testing valid inputs:')\nprint(f'  0: {v(0) == 0}')\nprint(f'  1.5: {v(1.5) == 1.5}')\nprint(f'  -100: {v(-100) == -100}')\nprint(f'  1e10: {v(1e10) == 1e10}')\n\n# Test invalid inputs\nprint('\\\\nTesting invalid inputs:')\ntry:\n    v(float('nan'))\n    print('  NaN: FAILED (should have raised)')\nexcept ValidationError as e:\n    print(f'  NaN: {str(e)}')\n\ntry:\n    v(float('inf'))\n    print('  inf: FAILED (should have raised)')\nexcept ValidationError as e:\n    print(f'  inf: {str(e)}')\n\ntry:\n    v(float('-inf'))\n    print('  -inf: FAILED (should have raised)')\nexcept ValidationError as e:\n    print(f'  -inf: {str(e)}')\n\n# Test with custom error message\nprint('\\\\nTesting custom error message:')\nv2 = validate.Finite(error='{input} is not a finite number')\ntry:\n    v2(float('nan'))\nexcept ValidationError as e:\n    print(f'  Custom error: {str(e)}')\n\n# Test repr\nprint('\\\\nTesting repr:')\nprint(f'  {repr(v)}')\n\"",
