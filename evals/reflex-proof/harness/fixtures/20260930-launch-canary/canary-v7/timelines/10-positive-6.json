   "command": ".venv/bin/python -c \"\nfrom marshmallow import validate\nimport math\n\n# Test basic instantiation\nv = validate.Finite()\nprint('Finite validator created:', v)\n\n# Test finite numbers\nprint('Valid (0):', v(0))\nprint('Valid (-1.25):', v(-1.25))\nprint('Valid (1e300):', v(1e300))\n\n# Test custom error message\nv_custom = validate.Finite(error='{input} is not finite')\nprint('Custom validator created:', v_custom)\n\n# Test that NaN raises error\ntry:\n    v(float('nan'))\nexcept Exception as e:\n    print('NaN raises:', type(e).__name__, '-', e)\n\n# Test that inf raises error\ntry:\n    v(float('inf'))\nexcept Exception as e:\n    print('Inf raises:', type(e).__name__, '-', e)\n\n# Test that -inf raises error  \ntry:\n    v(float('-inf'))\nexcept Exception as e:\n    print('-Inf raises:', type(e).__name__, '-', e)\n\n# Test custom message with inf\ntry:\n    v_custom(float('inf'))\nexcept Exception as e:\n    print('Custom error with inf:', str(e))\n\"\n",
