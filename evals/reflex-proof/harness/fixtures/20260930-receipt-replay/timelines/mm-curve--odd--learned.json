  {
   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nvalidator = validate.Odd()\n\n# Test valid odd numbers\nprint(\"Testing valid odd numbers:\")\nfor num in [1, 3, -1, -3, 999, -999]:\n    try:\n        result = validator(num)\n        print(f\"  {num}: \u2713 (valid)\")\n    except ValidationError as e:\n        print(f\"  {num}: \u2717 {e.messages}\")\n\n# Test invalid numbers\nprint(\"\\nTesting invalid (even) numbers:\")\nfor num in [0, 2, 4, -2, -4, 100]:\n    try:\n        result = validator(num)\n        print(f\"  {num}: \u2713 (valid)\")\n    except ValidationError as e:\n        print(f\"  {num}: \u2717 {e.messages[0]}\")\n\n# Test custom error message\nprint(\"\\nTesting custom error message:\")\ncustom_validator = validate.Odd(error=\"{input} must be odd!\")\ntry:\n    custom_validator(4)\nexcept ValidationError as e:\n    print(f\"  Error: {e.messages[0]}\")\nEOF\n",
   "digest": "89b7336455b47f030b24802376075977f30859b08c62a899f7a14d7ff87ab669",
