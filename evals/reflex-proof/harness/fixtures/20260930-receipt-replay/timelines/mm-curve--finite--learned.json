   "command": ".venv/bin/python -c \"\nfrom marshmallow import validate\nimport math\n\n# Test basic usage\nvalidator = validate.Finite()\n\n# Valid cases\nprint('Testing valid inputs:')\nprint(f'  0: {validator(0)}')\nprint(f'  1.5: {validator(1.5)}')\nprint(f'  1e308: {validator(1e308)}')\n\n# Invalid cases\nprint('\\\\nTesting invalid inputs:')\ntry:\n    validator(float('inf'))\nexcept Exception as e:\n    print(f'  inf: {type(e).__name__}')\n\ntry:\n    validator(float('-inf'))\nexcept Exception as e:\n    print(f'  -inf: {type(e).__name__}')\n\ntry:\n    validator(float('nan'))\nexcept Exception as e:\n    print(f'  nan: {type(e).__name__}')\n\ntry:\n    validator(1e309)\nexcept Exception as e:\n    print(f'  1e309: {type(e).__name__}')\n\n# Test custom error message\nprint('\\\\nTesting custom error:')\nv = validate.Finite(error='Custom: {input}')\ntry:\n    v(float('inf'))\nexcept Exception as e:\n    print(f'  Error message: {e.messages}')\n\"\n",
