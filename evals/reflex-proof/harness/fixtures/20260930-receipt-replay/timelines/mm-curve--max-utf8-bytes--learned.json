  {
   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nprint(\"=== Testing MaxUtf8Bytes Validator ===\\n\")\n\n# Test 1: Valid ASCII inputs\nprint(\"Test 1: Valid ASCII inputs\")\nv = validate.MaxUtf8Bytes(4)\nprint(f\"  MaxUtf8Bytes(4)('abcd') = '{v('abcd')}'\")\nprint(f\"  MaxUtf8Bytes(4)('') = '{v('')}'\")\n\n# Test 2: Invalid ASCII inputs\nprint(\"\\nTest 2: Invalid ASCII inputs\")\ntry:\n    v('abcde')\n    print(\"  ERROR: Should have raised ValidationError\")\nexcept ValidationError as e:\n    print(f\"  MaxUtf8Bytes(4)('abcde'): {e.messages[0]}\")\n\n# Test 3: UTF-8 multi-byte characters\nprint(\"\\nTest 3: UTF-8 multi-byte characters\")\nv_utf8 = validate.MaxUtf8Bytes(5)\nprint(f\"  MaxUtf8Bytes(5)('caf\u00e9') = '{v_utf8('caf\u00e9')}'\")\nprint(f\"  'caf\u00e9' in UTF-8 is {len('caf\u00e9'.encode('utf-8'))} bytes\")\n\n# Test 4: UTF-8 exceeding limit\nprint(\"\\nTest 4: UTF-8 exceeding limit\")\nv_utf8_strict = validate.MaxUtf8Bytes(3)\ntry:\n    v_utf8_strict('caf\u00e9')\n    print(\"  ERROR: Should have raised ValidationError\")\nexcept ValidationError as e:\n    print(f\"  MaxUtf8Bytes(3)('caf\u00e9'): {e.messages[0]}\")\n\n# Test 5: Custom error message\nprint(\"\\nTest 5: Custom error message\")\nv_custom = validate.MaxUtf8Bytes(4, error=\"'{input}' is {max} bytes max\")\ntry:\n    v_custom('hello')\nexcept ValidationError as e:\n    print(f\"  Custom message: {e.messages[0]}\")\n\n# Test 6: Repr\nprint(\"\\nTest 6: Repr\")\nprint(f\"  repr(MaxUtf8Bytes(4)) = {repr(validate.MaxUtf8Bytes(4))}\")\nprint(f\"  repr(MaxUtf8Bytes(10, error='x')) = {repr(validate.MaxUtf8Bytes(10, error='x'))}\")\n\nprint(\"\\n=== All tests passed! ===\")\nEOF\n",
