   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\n# Test with valid odd numbers\nvalidator = validate.Odd()\nprint(\"Testing valid inputs:\")\nprint(f\"validator(1) = {validator(1)}\")\nprint(f\"validator(3) = {validator(3)}\")\nprint(f\"validator(-1) = {validator(-1)}\")\nprint(f\"validator(-5) = {validator(-5)}\")\n\nprint(\"\\nTesting invalid inputs:\")\n# Test with invalid inputs\ninvalid_inputs = [0, 2, -2, 4]\nfor val in invalid_inputs:\n    try:\n        validator(val)\n        print(f\"validator({val}) - UNEXPECTED: no error\")\n    except ValidationError as e:\n        print(f\"validator({val}) - Error: {e.messages}\")\n\nprint(\"\\nTesting custom error message:\")\nv = validate.Odd(error=\"{input} is not an odd number\")\ntry:\n    v(2)\nexcept ValidationError as e:\n    print(f\"Custom error: {e.messages}\")\n\nprint(\"\\nTesting repr:\")\nprint(f\"repr(validate.Odd()) = {repr(validate.Odd())}\")\nprint(f\"repr(validate.Odd(error='custom')) = {repr(validate.Odd(error='custom'))}\")\nEOF\n",
