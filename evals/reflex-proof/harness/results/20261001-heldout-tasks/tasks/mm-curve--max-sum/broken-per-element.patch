index 35c0e8b..0622fdc 100644
--- a/src/marshmallow/validate.py
+++ b/src/marshmallow/validate.py
@@ -706,3 +706,31 @@ class ContainsNoneOf(NoneOf):
             if val in self.iterable:
                 raise ValidationError(self._format_error(value))
         return value
+
+
+class MaxSum(Validator):
+    """which succeeds if the input is a sequence of numbers whose sum is at most `max` (an empty sequence sums to 0).
+
+    :param error: Error message to raise in case of a validation error.
+    """
+
+    default_message = 'Sum must be at most {max}.'
+
+    def __init__(self, max, *, error: str | None = None):
+        self.max = max
+        self.error: str = error or self.default_message
+
+    def _repr_args(self) -> str:
+        return f"max={self.max!r}"
+
+    def _format_error(self, value) -> str:
+        return self.error.format(input=value, max=self.max)
+
+    def __call__(self, value):
+        try:
+            ok = all(v <= self.max for v in value)
+        except (TypeError, ValueError):
+            ok = False
+        if not ok:
+            raise ValidationError(self._format_error(value))
+        return value
