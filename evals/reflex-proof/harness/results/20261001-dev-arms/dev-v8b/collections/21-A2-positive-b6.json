        "command": "python -c \"\nfrom marshmallow import validate, ValidationError\n\n# Test basic finite numbers\nv = validate.Finite()\nprint('Testing 0:', v(0))\nprint('Testing -1.25:', v(-1.25))\nprint('Testing 1e300:', v(1e300))\n\n# Test that 1e309 is rejected (it's infinity)\ntry:\n    v(1e309)\n    print('ERROR: 1e309 should be rejected!')\nexcept ValidationError as e:\n    print('1e309 correctly rejected:', e.messages)\n\n# Test custom error message\nv2 = validate.Finite(error='{input} is not finite')\ntry:\n    v2(float('inf'))\nexcept ValidationError as e:\n    print('Custom error message works:', e.messages)\n\"\n",
