      {
        "classification": "opaque_shell",
        "command": "python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nvalidator = validate.Finite()\n\n# Test valid inputs\ntest_values = [0, 1, -1, 1.5, -1.5, 1e300, 1e-300]\nfor val in test_values:\n    try:\n        result = validator(val)\n        print(f\"\u2713 {val} accepted\")\n    except ValidationError as e:\n        print(f\"\u2717 {val} rejected: {e}\")\n\n# Test invalid inputs\ninvalid_values = [float('nan'), float('inf'), float('-inf'), True, False]\nfor val in invalid_values:\n    try:\n        result = validator(val)\n        print(f\"\u2717 {val} accepted (should have been rejected)\")\n    except ValidationError as e:\n        print(f\"\u2713 {val} rejected\")\n\n# Test custom error message\nvalidator_custom = validate.Finite(error=\"{input} is not finite\")\ntry:\n    validator_custom(float('inf'))\nexcept ValidationError as e:\n    print(f\"\u2713 Custom error: {e}\")\n\nEOF\n",
