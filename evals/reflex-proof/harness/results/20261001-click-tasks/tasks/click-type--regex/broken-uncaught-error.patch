diff --git a/src/click/types.py b/src/click/types.py
index b6e98a9..62a11af 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -4,6 +4,7 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
@@ -1435,3 +1436,22 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+class RegexParamType(ParamType[t.Any]):
+    name = 'regex'
+
+    def convert(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> t.Any:
+        def fail(v: t.Any) -> t.NoReturn:
+            self.fail(_("{value!r} is not a valid regex.").format(value=v), param, ctx)
+
+        if not isinstance(value, str):
+            return value
+        return re.compile(value)
+
+    def __repr__(self) -> str:
+        return 'REGEX'
+
+
+#: A regex parameter.
+REGEX: t.Final[RegexParamType] = RegexParamType()
