diff --git a/src/click/types.py b/src/click/types.py
index b6e98a9..5c704a1 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -4,6 +4,7 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
@@ -1435,3 +1436,25 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+class KeyValueParamType(ParamType[t.Any]):
+    name = 'key value'
+
+    def convert(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> t.Any:
+        def fail(v: t.Any) -> t.NoReturn:
+            self.fail(_("{value!r} is not a valid key value.").format(value=v), param, ctx)
+
+        if not isinstance(value, str):
+            return value
+        key, sep, val = value.partition("=")
+        if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
+            fail(value)
+        return (key, val)
+
+    def __repr__(self) -> str:
+        return 'KEY_VALUE'
+
+
+#: A key value parameter.
+KEY_VALUE: t.Final[KeyValueParamType] = KeyValueParamType()
