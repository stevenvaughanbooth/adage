diff --git a/src/click/types.py b/src/click/types.py
index b6e98a9..c67b41f 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -4,6 +4,7 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
@@ -1435,3 +1436,29 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+class JsonObjectParamType(ParamType[t.Any]):
+    name = 'json object'
+
+    def convert(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> t.Any:
+        def fail(v: t.Any) -> t.NoReturn:
+            self.fail(_("{value!r} is not a valid json object.").format(value=v), param, ctx)
+
+        if not isinstance(value, str):
+            return value
+        import ast
+        try:
+            obj = ast.literal_eval(value.strip())
+        except (ValueError, SyntaxError):
+            fail(value)
+        if not isinstance(obj, dict):
+            fail(value)
+        return obj
+
+    def __repr__(self) -> str:
+        return 'JSON_OBJECT'
+
+
+#: A json object parameter.
+JSON_OBJECT: t.Final[JsonObjectParamType] = JsonObjectParamType()
