diff --git a/src/click/types.py b/src/click/types.py
index b6e98a9..61f8d0f 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -4,6 +4,7 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
@@ -1435,3 +1436,25 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+class IntListParamType(ParamType[t.Any]):
+    name = 'int list'
+
+    def convert(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> t.Any:
+        def fail(v: t.Any) -> t.NoReturn:
+            self.fail(_("{value!r} is not a valid int list.").format(value=v), param, ctx)
+
+        if not isinstance(value, str):
+            return value
+        try:
+            return [int(float(item)) for item in value.split(",")]
+        except ValueError:
+            fail(value)
+
+    def __repr__(self) -> str:
+        return 'INT_LIST'
+
+
+#: A int list parameter.
+INT_LIST: t.Final[IntListParamType] = IntListParamType()
