diff --git a/src/click/types.py b/src/click/types.py
index b6e98a9..6654f4b 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -4,6 +4,7 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
@@ -1435,3 +1436,26 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+class LogLevelParamType(ParamType[t.Any]):
+    name = 'log level'
+
+    def convert(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> t.Any:
+        def fail(v: t.Any) -> t.NoReturn:
+            self.fail(_("{value!r} is not a valid log level.").format(value=v), param, ctx)
+
+        if not isinstance(value, str):
+            return value
+        levels = {"DEBUG": 10, "INFO": 20, "WARNING": 30, "ERROR": 40, "CRITICAL": 50}
+        key = value.strip().upper()
+        if key not in levels:
+            fail(value)
+        return levels[key]
+
+    def __repr__(self) -> str:
+        return 'LOG_LEVEL'
+
+
+#: A log level parameter.
+LOG_LEVEL: t.Final[LogLevelParamType] = LogLevelParamType()
