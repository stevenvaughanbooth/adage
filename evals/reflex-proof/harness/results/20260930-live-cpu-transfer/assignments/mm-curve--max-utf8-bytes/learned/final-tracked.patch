diff --git a/src/marshmallow/validate.py b/src/marshmallow/validate.py
index 35c0e8b..fa109ef 100644
--- a/src/marshmallow/validate.py
+++ b/src/marshmallow/validate.py
@@ -706,3 +706,31 @@ class ContainsNoneOf(NoneOf):
             if val in self.iterable:
                 raise ValidationError(self._format_error(value))
         return value
+
+
+class MaxUtf8Bytes(Validator):
+    """Validator which succeeds if the value passed to it is a string whose
+    UTF-8 encoding is at most ``max`` bytes long. Empty strings are considered valid.
+
+    :param max: The maximum number of UTF-8 bytes allowed.
+    :param error: Error message to raise in case of a validation error.
+        Can be interpolated with `{input}` and `{max}`.
+    """
+
+    default_message = "Must occupy at most {max} UTF-8 bytes."
+
+    def __init__(self, max: int, *, error: str | None = None):  # noqa: A002
+        self.max = max
+        self.error = error
+
+    def _repr_args(self) -> str:
+        return f"max={self.max!r}"
+
+    def _format_error(self, value: str) -> str:
+        return (self.error or self.default_message).format(input=value, max=self.max)
+
+    def __call__(self, value: str) -> str:
+        byte_length = len(value.encode("utf-8"))
+        if byte_length > self.max:
+            raise ValidationError(self._format_error(value))
+        return value
diff --git a/tests/test_validate.py b/tests/test_validate.py
index 752e544..232a755 100644
--- a/tests/test_validate.py
+++ b/tests/test_validate.py
@@ -1099,3 +1099,28 @@ def test_and():
 
     errors = excinfo.value.messages
     assert errors == ["Not an even value.", "Must be less than or equal to 6."]
+
+
+def test_max_utf8_bytes():
+    assert validate.MaxUtf8Bytes(4)("abcd") == "abcd"
+    assert validate.MaxUtf8Bytes(4)("") == ""
+    assert validate.MaxUtf8Bytes(5)("hello") == "hello"
+    assert validate.MaxUtf8Bytes(6)("café") == "café"
+
+    with pytest.raises(ValidationError):
+        validate.MaxUtf8Bytes(4)("abcde")
+    with pytest.raises(ValidationError):
+        validate.MaxUtf8Bytes(3)("café")
+
+
+def test_max_utf8_bytes_custom_message():
+    v = validate.MaxUtf8Bytes(4, error="{input} is too long ({max} bytes max)")
+    with pytest.raises(ValidationError, match="hello is too long"):
+        v("hello")
+
+
+def test_max_utf8_bytes_repr():
+    assert repr(validate.MaxUtf8Bytes(4)) == "<MaxUtf8Bytes(max=4, error=None)>"
+    assert repr(
+        validate.MaxUtf8Bytes(10, error="custom")
+    ) == "<MaxUtf8Bytes(max=10, error='custom')>"
