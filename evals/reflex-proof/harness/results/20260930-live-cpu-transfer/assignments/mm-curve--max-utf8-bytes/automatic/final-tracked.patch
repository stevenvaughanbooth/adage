+def test_max_utf8_bytes():
+    assert validate.MaxUtf8Bytes(4)("abcd") == "abcd"
+    assert validate.MaxUtf8Bytes(4)("") == ""
+    assert validate.MaxUtf8Bytes(1)("a") == "a"
+    assert validate.MaxUtf8Bytes(6)("café") == "café"
+
+    with pytest.raises(ValidationError):
+        validate.MaxUtf8Bytes(4)("abcde")
+    with pytest.raises(ValidationError):
+        validate.MaxUtf8Bytes(3)("café")
+
+
+def test_max_utf8_bytes_custom_message():
+    v = validate.MaxUtf8Bytes(4, error="{input} must occupy at most {max} bytes")
+    with pytest.raises(ValidationError, match="abcde must occupy at most 4 bytes"):
+        v("abcde")
+
+
+def test_max_utf8_bytes_repr():
+    assert repr(
+        validate.MaxUtf8Bytes(max=4, error=None)
+    ) == "<MaxUtf8Bytes(max=4, error={!r})>".format("Must occupy at most {max} UTF-8 bytes.")
+    assert repr(
+        validate.MaxUtf8Bytes(max=10, error="custom")
+    ) == "<MaxUtf8Bytes(max=10, error={!r})>".format("custom")
+
+
