diff --git a/src/marshmallow/validate.py b/src/marshmallow/validate.py
index 35c0e8b..fea2d5c 100644
--- a/src/marshmallow/validate.py
+++ b/src/marshmallow/validate.py
@@ -706,3 +706,26 @@ class ContainsNoneOf(NoneOf):
             if val in self.iterable:
                 raise ValidationError(self._format_error(value))
         return value
+
+
+class Odd(Validator):
+    """Validator which succeeds if the value is an odd integer.
+
+    Includes both positive and negative odd integers.
+
+    :param error: Error message to raise in case of a validation error.
+        Can be interpolated with `{input}`.
+    """
+
+    default_message = "Must satisfy Odd."
+
+    def __init__(self, *, error: str | None = None):
+        self.error: str = error or self.default_message
+
+    def _format_error(self, value: typing.Any) -> str:
+        return self.error.format(input=value)
+
+    def __call__(self, value: typing.Any) -> typing.Any:
+        if not isinstance(value, int) or isinstance(value, bool) or value % 2 != 1:
+            raise ValidationError(self._format_error(value))
+        return value
diff --git a/tests/test_validate.py b/tests/test_validate.py
index 752e544..6f5704c 100644
--- a/tests/test_validate.py
+++ b/tests/test_validate.py
@@ -1099,3 +1099,35 @@ def test_and():
 
     errors = excinfo.value.messages
     assert errors == ["Not an even value.", "Must be less than or equal to 6."]
+
+
+def test_odd():
+    validator = validate.Odd()
+    assert validator(1) == 1
+    assert validator(3) == 3
+    assert validator(-1) == -1
+    assert validator(-3) == -3
+
+    with pytest.raises(ValidationError):
+        validator(0)
+    with pytest.raises(ValidationError):
+        validator(2)
+    with pytest.raises(ValidationError):
+        validator(-2)
+    with pytest.raises(ValidationError):
+        validator(4)
+
+
+def test_odd_custom_message():
+    v = validate.Odd(error="{input} is not odd.")
+    with pytest.raises(ValidationError, match="2 is not odd."):
+        v(2)
+
+
+def test_odd_repr():
+    assert repr(
+        validate.Odd(error=None)
+    ) == "<Odd(error={!r})>".format("Must satisfy Odd.")
+    assert repr(
+        validate.Odd(error="foo")
+    ) == "<Odd(error={!r})>".format("foo")
