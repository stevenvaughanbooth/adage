+def test_finite():
+    assert validate.Finite()(0) == 0
+    assert validate.Finite()(1.5) == 1.5
+    assert validate.Finite()(-1) == -1
+    assert validate.Finite()(1e308) == 1e308
+    assert validate.Finite()(-1e308) == -1e308
+
+    with pytest.raises(ValidationError):
+        validate.Finite()(float("nan"))
+    with pytest.raises(ValidationError):
+        validate.Finite()(float("inf"))
+    with pytest.raises(ValidationError):
+        validate.Finite()(float("-inf"))
+
+
+def test_finite_custom_message():
+    v = validate.Finite(error="{input} is not finite")
+    with pytest.raises(ValidationError, match="inf is not finite"):
+        v(float("inf"))
+
+
+def test_finite_repr():
+    assert repr(validate.Finite(error=None)) == "<Finite(error={!r})>".format(
+        "Must satisfy Finite."
+    )
+    assert repr(validate.Finite(error="foo")) == "<Finite(error={!r})>".format("foo")
+
+
