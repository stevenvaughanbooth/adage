@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import math
 import re
 import typing
 from abc import ABC, abstractmethod
@@ -706,3 +707,25 @@ class ContainsNoneOf(NoneOf):
             if val in self.iterable:
                 raise ValidationError(self._format_error(value))
         return value
+
+
+class Finite(Validator):
+    """Validator which succeeds if the value is a finite real number.
+    NaN and positive or negative infinity are considered invalid.
+
+    :param error: Error message to raise in case of a validation error.
+        Can be interpolated with `{input}`.
+    """
+
+    default_message = "Must satisfy Finite."
+
+    def __init__(self, *, error: str | None = None):
+        self.error: str = error or self.default_message
+
+    def _format_error(self, value: typing.Any) -> str:
+        return self.error.format(input=value)
+
+    def __call__(self, value: typing.Any) -> typing.Any:
+        if not isinstance(value, (int, float)) or not math.isfinite(value):
+            raise ValidationError(self._format_error(value))
+        return value
diff --git a/tests/test_validate.py b/tests/test_validate.py
index 752e544..a36638a 100644
--- a/tests/test_validate.py
+++ b/tests/test_validate.py
@@ -1099,3 +1099,37 @@ def test_and():
 
     errors = excinfo.value.messages
     assert errors == ["Not an even value.", "Must be less than or equal to 6."]
+
+
+def test_finite():
+    validator = validate.Finite()
+    assert validator(0) == 0
+    assert validator(1) == 1
+    assert validator(-1) == -1
+    assert validator(1.5) == 1.5
+    assert validator(-1.5) == -1.5
+    assert validator(1e308) == 1e308
+
+    with pytest.raises(ValidationError):
+        validator(float("inf"))
+    with pytest.raises(ValidationError):
+        validator(float("-inf"))
+    with pytest.raises(ValidationError):
+        validator(float("nan"))
+    with pytest.raises(ValidationError):
+        validator(1e309)
+
+
+def test_finite_custom_message():
+    validator = validate.Finite(error="{input} is not a finite number")
+    with pytest.raises(ValidationError, match="inf is not a finite number"):
+        validator(float("inf"))
+
+
+def test_finite_repr():
+    assert repr(
+        validate.Finite(error=None)
+    ) == "<Finite(error={!r})>".format("Must satisfy Finite.")
+    assert repr(
+        validate.Finite(error="foo")
+    ) == "<Finite(error={!r})>".format("foo")
