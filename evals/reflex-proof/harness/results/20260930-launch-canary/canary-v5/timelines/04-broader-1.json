  {
   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\nimport math\n\n# Test the example from requirements: 0 (valid)\nv = validate.Finite()\ntry:\n    result = v(0)\n    print(f\"\u2713 0 is valid: {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 0 is invalid: {e}\")\n\n# Test the example from requirements: 1e309 (invalid)\ntry:\n    result = v(1e309)\n    print(f\"\u2717 1e309 is valid (should be invalid): {result}\")\nexcept ValidationError as e:\n    print(f\"\u2713 1e309 is invalid: {e.messages}\")\n\n# Check what 1e309 actually is\nprint(f\"\\n1e309 value: {1e309}\")\nprint(f\"math.isfinite(1e309): {math.isfinite(1e309)}\")\n\n# Test NaN\ntry:\n    result = v(float('nan'))\n    print(f\"\u2717 NaN is valid (should be invalid)\")\nexcept ValidationError as e:\n    print(f\"\u2713 NaN is invalid: {e.messages}\")\n\n# Test infinity\ntry:\n    result = v(float('inf'))\n    print(f\"\u2717 inf is valid (should be invalid)\")\nexcept ValidationError as e:\n    print(f\"\u2713 inf is invalid: {e.messages}\")\n\n# Test custom message\nv_custom = validate.Finite(error=\"Custom: {input}\")\ntry:\n    v_custom(float('inf'))\nexcept ValidationError as e:\n    print(f\"\u2713 Custom message: {e.messages}\")\n\n# Test repr\nprint(f\"\\nRepr: {repr(v)}\")\nEOF\n",
   "digest": "febefb58008517b25ab5745a285d3f9836a59fdc039674db5c3a85b2a2db1370",
