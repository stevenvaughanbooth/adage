   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\nimport math\n\nv = validate.Finite()\n\n# Test valid inputs\nprint(\"Testing valid inputs:\")\nprint(\"0:\", v(0))\nprint(\"1.5:\", v(1.5))\nprint(\"1e10:\", v(1e10))\nprint(\"-1.5:\", v(-1.5))\n\n# Test invalid inputs\nprint(\"\\nTesting invalid inputs:\")\ntry:\n    v(float('nan'))\nexcept ValidationError as e:\n    print(\"NaN: ValidationError -\", e)\n\ntry:\n    v(float('inf'))\nexcept ValidationError as e:\n    print(\"inf: ValidationError -\", e)\n\ntry:\n    v(1e309)\nexcept ValidationError as e:\n    print(\"1e309: ValidationError -\", e)\n\n# Test custom error message\nprint(\"\\nTesting custom error message:\")\nv_custom = validate.Finite(error=\"{input} is not finite.\")\ntry:\n    v_custom(float('nan'))\nexcept ValidationError as e:\n    print(\"Custom error:\", e)\nEOF\n",
