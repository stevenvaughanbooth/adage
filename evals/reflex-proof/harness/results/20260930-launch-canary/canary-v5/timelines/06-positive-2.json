   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow.validate import Finite\nfrom marshmallow.exceptions import ValidationError\nimport math\n\nprint(\"Testing edge cases:\")\n\n# Test very large finite numbers\ntry:\n    result = Finite()(1e308)\n    print(f\"\u2713 1e308 (large finite): {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 1e308 rejected: {e}\")\n\n# Test very small finite numbers\ntry:\n    result = Finite()(1e-308)\n    print(f\"\u2713 1e-308 (small finite): {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 1e-308 rejected: {e}\")\n\n# Test negative numbers\ntry:\n    result = Finite()(-100)\n    print(f\"\u2713 -100 (negative): {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 -100 rejected: {e}\")\n\n# Test zero\ntry:\n    result = Finite()(0)\n    print(f\"\u2713 0 (zero): {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 0 rejected: {e}\")\n\n# Test positive infinity\ntry:\n    Finite()(float(\"inf\"))\n    print(f\"\u2717 +inf accepted (should be rejected)\")\nexcept ValidationError:\n    print(f\"\u2713 +inf rejected\")\n\n# Test negative infinity\ntry:\n    Finite()(float(\"-inf\"))\n    print(f\"\u2717 -inf accepted (should be rejected)\")\nexcept ValidationError:\n    print(f\"\u2713 -inf rejected\")\n\n# Test NaN\ntry:\n    Finite()(float(\"nan\"))\n    print(f\"\u2717 NaN accepted (should be rejected)\")\nexcept ValidationError:\n    print(f\"\u2713 NaN rejected\")\n\n# Test non-numeric types\ntry:\n    Finite()(\"123\")\n    print(f\"\u2717 string accepted (should be rejected)\")\nexcept ValidationError:\n    print(f\"\u2713 string rejected\")\n\n# Test None\ntry:\n    Finite()(None)\n    print(f\"\u2717 None accepted (should be rejected)\")\nexcept ValidationError:\n    print(f\"\u2713 None rejected\")\nEOF\n",
