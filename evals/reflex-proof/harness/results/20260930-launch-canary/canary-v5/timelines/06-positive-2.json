   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow.validate import Finite\nfrom marshmallow.exceptions import ValidationError\n\n# Test valid input: 0\nprint(f\"Valid input (0): {Finite()(0)}\")\n\n# Test invalid input: 1e309\ntry:\n    result = Finite()(1e309)\n    print(f\"1e309 accepted (should have been rejected): {result}\")\nexcept ValidationError as e:\n    print(f\"Invalid input (1e309) rejected: {e}\")\n\n# Also check what 1e309 is\nimport math\nprint(f\"1e309 value: {1e309}\")\nprint(f\"Is 1e309 finite? {math.isfinite(1e309)}\")\nEOF\n",
   "digest": "3d2a51234aff5d6e2e671e1edafc7fd62327a4ba26130ca7fcadd0f18439c85d",
