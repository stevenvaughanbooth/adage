   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow.validate import Finite\nfrom marshmallow.exceptions import ValidationError\n\n# Test infinity\ntry:\n    Finite()(float(\"inf\"))\nexcept ValidationError as e:\n    print(f\"inf rejected: {e}\")\n\n# Test negative infinity\ntry:\n    Finite()(float(\"-inf\"))\nexcept ValidationError as e:\n    print(f\"-inf rejected: {e}\")\n\n# Test NaN\ntry:\n    Finite()(float(\"nan\"))\nexcept ValidationError as e:\n    print(f\"nan rejected: {e}\")\n\n# Test 1e309 (which should be infinity)\ntry:\n    Finite()(1e309)\nexcept ValidationError as e:\n    print(f\"1e309 rejected: {e}\")\n\n# Test valid number\nprint(f\"0 accepted: {Finite()(0)}\")\nprint(f\"1.5 accepted: {Finite()(1.5)}\")\n\n# Test custom error message\nvalidator = Finite(error=\"Invalid: {input}\")\ntry:\n    validator(float(\"inf\"))\nexcept ValidationError as e:\n    print(f\"Custom error: {e}\")\nEOF\n",
