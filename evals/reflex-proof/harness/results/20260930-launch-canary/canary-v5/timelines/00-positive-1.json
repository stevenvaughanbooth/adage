   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nv = validate.Finite()\n\n# Valid input example: 0\nprint(\"Testing valid input (0):\")\ntry:\n    result = v(0)\n    print(f\"  \u2713 Result: {result}\")\nexcept ValidationError as e:\n    print(f\"  \u2717 Error: {e.messages}\")\n\n# Invalid input example: 1e309 (which is infinity)\nprint(\"\\nTesting invalid input (1e309):\")\ntry:\n    result = v(1e309)\n    print(f\"  \u2717 Should have failed but got: {result}\")\nexcept ValidationError as e:\n    print(f\"  \u2713 Error: {e.messages}\")\n\n# Verify default error message\nprint(f\"\\nDefault error message: {repr(v.error)}\")\n\n# Verify custom error message with interpolation\nv_custom = validate.Finite(error=\"Value {input} is not finite\")\nprint(\"\\nTesting custom error message:\")\ntry:\n    v_custom(float('inf'))\nexcept ValidationError as e:\n    print(f\"  \u2713 Error: {e.messages}\")\nEOF\n",
