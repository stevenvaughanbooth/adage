  {
   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\nimport math\n\nv = validate.Finite()\n\n# Test valid values\nprint(\"Testing valid values:\")\ntry:\n    print(f\"  0: {v(0)}\")\n    print(f\"  1.5: {v(1.5)}\")\n    print(f\"  1e308: {v(1e308)}\")\n    print(\"\u2713 All valid values passed\")\nexcept ValidationError as e:\n    print(f\"\u2717 Unexpected error: {e}\")\n\n# Test invalid values\nprint(\"\\nTesting invalid values:\")\ninvalid_values = [float('nan'), float('inf'), float('-inf')]\nfor val in invalid_values:\n    try:\n        v(val)\n        print(f\"\u2717 {val} should have failed\")\n    except ValidationError as e:\n        print(f\"  {val}: {e.messages[0]}\")\n\n# Test custom error message\nprint(\"\\nTesting custom error message:\")\nv_custom = validate.Finite(error=\"Custom: {input}\")\ntry:\n    v_custom(float('inf'))\nexcept ValidationError as e:\n    print(f\"  {e.messages[0]}\")\n\n# Test repr\nprint(\"\\nTesting repr:\")\nprint(f\"  {repr(validate.Finite())}\")\nprint(f\"  {repr(validate.Finite(error='custom'))}\")\nEOF\n",
   "digest": "d6c8645969b56c3b2524b6ad6dfff4dae8c9f9147c268b11b7164865229d577a",
