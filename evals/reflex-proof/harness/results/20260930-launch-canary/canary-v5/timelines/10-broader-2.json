   "adage_pre_context": false,
   "command": ".venv/bin/python -c \"\nfrom marshmallow import validate, ValidationError\nimport math\n\n# Test valid inputs\nvalidator = validate.Finite()\nprint('Testing valid inputs:')\nprint(f'  0: {validator(0)}')\nprint(f'  1: {validator(1)}')\nprint(f'  -1: {validator(-1)}')\nprint(f'  3.14: {validator(3.14)}')\n\n# Test invalid inputs\nprint('\\nTesting invalid inputs:')\nfor invalid in [float('inf'), float('-inf'), float('nan')]:\n    try:\n        validator(invalid)\n        print(f'  {invalid}: FAILED (should have raised)')\n    except ValidationError as e:\n        print(f'  {invalid}: {e.messages}')\n\n# Test custom error message\nprint('\\nTesting custom error message:')\ncustom_validator = validate.Finite(error='{input} is not finite')\ntry:\n    custom_validator(float('inf'))\nexcept ValidationError as e:\n    print(f'  {e.messages}')\n\n# Test repr\nprint('\\nTesting repr:')\nprint(f'  {repr(validator)}')\nprint(f'  {repr(custom_validator)}')\n\"\n",
