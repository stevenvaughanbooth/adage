   "command": ".venv/bin/python -c \"\nfrom marshmallow import validate\nfrom marshmallow.exceptions import ValidationError\n\n# Test valid inputs\nv = validate.Finite()\nprint('Testing valid inputs:')\nprint(f'  0: {v(0)}')\nprint(f'  1.5: {v(1.5)}')\nprint(f'  -42: {v(-42)}')\n\n# Test invalid inputs\nprint('Testing invalid inputs:')\ntry:\n    v(float('nan'))\nexcept ValidationError as e:\n    print(f'  NaN: {e}')\n\ntry:\n    v(float('inf'))\nexcept ValidationError as e:\n    print(f'  inf: {e}')\n\ntry:\n    v(float('-inf'))\nexcept ValidationError as e:\n    print(f'  -inf: {e}')\n\ntry:\n    v(1e309)  # This becomes inf in Python\nexcept ValidationError as e:\n    print(f'  1e309: {e}')\n\n# Test custom message\nprint('Testing custom message:')\nv2 = validate.Finite(error='{input} is not a finite number')\ntry:\n    v2(float('inf'))\nexcept ValidationError as e:\n    print(f'  Custom error: {e}')\n\"\n",
