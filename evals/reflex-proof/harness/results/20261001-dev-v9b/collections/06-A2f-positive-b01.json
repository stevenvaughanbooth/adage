        "adage_pre_context": false,
        "command": ".venv/bin/python -c \"\nfrom marshmallow import validate, ValidationError\nimport math\n\n# Test the Finite validator\nvalidator = validate.Finite()\n\n# Test valid values\nprint('Testing valid values:')\nfor val in (0, -1.25, 1e300):\n    result = validator(val)\n    print(f'  {val}: {result}')\n\n# Test invalid values\nprint('\\\\nTesting invalid values:')\nfor val in (float('nan'), float('inf'), float('-inf')):\n    try:\n        validator(val)\n    except ValidationError as e:\n        print(f'  {val}: {e.messages}')\n\n# Test custom error message\nprint('\\\\nTesting custom error message:')\ncustom_validator = validate.Finite(error='{input} is not finite')\ntry:\n    custom_validator(float('inf'))\nexcept ValidationError as e:\n    print(f'  {e.messages}')\n\"\n",
