{
  "autoMemoryEnabled": false,
  "disableAllHooks": true,
  "permissions": {
    "allow": [
      "Read",
      "Bash(.venv/bin/python native_canary.py)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.venv)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.venv/**)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.git)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.git/**)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.claude)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.claude/**)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.agents)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.agents/**)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.codex)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/.codex/**)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/native_canary.py)",
      "Edit(/<EVAL_ROOT>/sessions/native-confinement/repo/native_canary.py/**)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "BROWSER_USE_ACCESS_VERIFYING_IDENTITY"
        },
        {
          "mode": "deny",
          "name": "COLORTERM"
        },
        {
          "mode": "deny",
          "name": "COMMAND_MODE"
        },
        {
          "mode": "deny",
          "name": "CPATH"
        },
        {
          "mode": "deny",
          "name": "DISABLE_AUTO_UPDATE"
        },
        {
          "mode": "deny",
          "name": "FPATH"
        },
        {
          "mode": "deny",
          "name": "GH_PAGER"
        },
        {
          "mode": "deny",
          "name": "GIT_PAGER"
        },
        {
          "mode": "deny",
          "name": "GOCACHE"
        },
        {
          "mode": "deny",
          "name": "HOMEBREW_CELLAR"
        },
        {
          "mode": "deny",
          "name": "HOMEBREW_PREFIX"
        },
        {
          "mode": "deny",
          "name": "HOMEBREW_REPOSITORY"
        },
        {
          "mode": "deny",
          "name": "INFOPATH"
        },
        {
          "mode": "deny",
          "name": "LC_ALL"
        },
        {
          "mode": "deny",
          "name": "LC_CTYPE"
        },
        {
          "mode": "deny",
          "name": "LIBRARY_PATH"
        },
        {
          "mode": "deny",
          "name": "LOG_FORMAT"
        },
        {
          "mode": "deny",
          "name": "MANPATH"
        },
        {
          "mode": "deny",
          "name": "MallocNanoZone"
        },
        {
          "mode": "deny",
          "name": "NO_COLOR"
        },
        {
          "mode": "deny",
          "name": "OLDPWD"
        },
        {
          "mode": "deny",
          "name": "OSLogRateLimit"
        },
        {
          "mode": "deny",
          "name": "PAGER"
        },
        {
          "mode": "deny",
          "name": "REPOBENCH_CACHE"
        },
        {
          "mode": "deny",
          "name": "RUST_LOG"
        },
        {
          "mode": "deny",
          "name": "SDKROOT"
        },
        {
          "mode": "deny",
          "name": "SSH_AUTH_SOCK"
        },
        {
          "mode": "deny",
          "name": "STARSHIP_SESSION_KEY"
        },
        {
          "mode": "deny",
          "name": "STARSHIP_SHELL"
        },
        {
          "mode": "deny",
          "name": "XPC_FLAGS"
        },
        {
          "mode": "deny",
          "name": "XPC_SERVICE_NAME"
        },
        {
          "mode": "deny",
          "name": "ZSH_TMUX_AUTOSTART"
        },
        {
          "mode": "deny",
          "name": "ZSH_TMUX_AUTOSTARTED"
        },
        {
          "mode": "deny",
          "name": "__CF_USER_TEXT_ENCODING"
        }
      ]
    },
    "enabled": true,
    "excludedCommands": [],
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        "<EVAL_ROOT>/sessions/native-confinement/repo",
        "<EVAL_ROOT>/runtime/python"
      ],
      "denyRead": [
        "<USER_HOME>",
        "<EVAL_ROOT>"
      ],
      "denyWrite": [
        "<EVAL_ROOT>/sessions/native-confinement/repo/.venv",
        "<EVAL_ROOT>/sessions/native-confinement/repo/.git",
        "<EVAL_ROOT>/sessions/native-confinement/repo/.claude",
        "<EVAL_ROOT>/sessions/native-confinement/repo/.agents",
        "<EVAL_ROOT>/sessions/native-confinement/repo/.codex",
        "<EVAL_ROOT>/sessions/native-confinement/repo/native_canary.py"
      ]
    },
    "network": {
      "allowAllUnixSockets": false,
      "allowLocalBinding": false,
      "allowedDomains": [],
      "deniedDomains": [
        "*"
      ]
    }
  }
}
