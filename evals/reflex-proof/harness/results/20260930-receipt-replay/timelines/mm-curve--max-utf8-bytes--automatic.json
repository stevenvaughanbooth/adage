  {
   "adage_pre_context": false,
   "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\n# Test examples from the requirements\nv = validate.MaxUtf8Bytes(4)\n\n# Valid input: 'abcd' (4 bytes)\ntry:\n    result = v('abcd')\n    print(f\"\u2713 'abcd' is valid: {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 'abcd' failed: {e}\")\n\n# Invalid input: 'abcde' (5 bytes)\ntry:\n    result = v('abcde')\n    print(f\"\u2717 'abcde' should be invalid\")\nexcept ValidationError as e:\n    print(f\"\u2713 'abcde' is invalid: {e.messages}\")\n\n# Empty string (should be valid)\ntry:\n    result = v('')\n    print(f\"\u2713 Empty string is valid: {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 Empty string failed: {e}\")\n\n# Multi-byte UTF-8 characters\nv6 = validate.MaxUtf8Bytes(6)\ntry:\n    result = v6('caf\u00e9')  # 'c' (1) + 'a' (1) + 'f' (1) + '\u00e9' (2) = 5 bytes\n    print(f\"\u2713 'caf\u00e9' (5 bytes) is valid with max=6: {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 'caf\u00e9' failed: {e}\")\n\nv4 = validate.MaxUtf8Bytes(4)\ntry:\n    result = v4('caf\u00e9')\n    print(f\"\u2717 'caf\u00e9' should be invalid with max=4\")\nexcept ValidationError as e:\n    print(f\"\u2713 'caf\u00e9' is invalid with max=4: {e.messages}\")\n\n# Test custom error message\nv_custom = validate.MaxUtf8Bytes(4, error=\"{input} is {max} max\")\ntry:\n    v_custom('abcde')\nexcept ValidationError as e:\n    print(f\"\u2713 Custom error message: {e.messages}\")\n\n# Test repr\nprint(f\"\\n\u2713 repr: {repr(v)}\")\nEOF\n",
   "digest": "614edadb52c95aec8aa36bfadd8f428413801cb26d110e1f695d2d90d94e311c",
