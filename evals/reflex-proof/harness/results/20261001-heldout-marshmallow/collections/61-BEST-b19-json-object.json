        "command": ".venv/bin/python -c \"\nfrom marshmallow.validate import JsonObject\nfrom marshmallow.exceptions import ValidationError\n\nvalidator = JsonObject()\n\n# Valid input\ntry:\n    result = validator('{\\\"a\\\": 1}')\n    print(f'\u2713 Valid: {{\\\"a\\\": 1}} -> {result}')\nexcept ValidationError as e:\n    print(f'\u2717 Valid: {{\\\"a\\\": 1}} failed: {e.messages}')\n\n# Invalid input - array\ntry:\n    result = validator('[1, 2]')\n    print(f'\u2717 Invalid: [1, 2] should have failed')\nexcept ValidationError as e:\n    print(f'\u2713 Invalid: [1, 2] -> {e.messages}')\n\n# Valid with whitespace\ntry:\n    result = validator('  {\\\"key\\\": \\\"value\\\"}  ')\n    print(f'\u2713 Valid with whitespace: \\\"  {{\\\"key\\\": \\\"value\\\"}}  \\\" passes')\nexcept ValidationError as e:\n    print(f'\u2717 Valid with whitespace failed: {e.messages}')\n\n# Test custom error message\nvalidator_custom = JsonObject(error='Invalid JSON object: {input}')\ntry:\n    validator_custom('[1, 2]')\nexcept ValidationError as e:\n    print(f'\u2713 Custom error: [1, 2] -> {e.messages}')\n\"\n",
