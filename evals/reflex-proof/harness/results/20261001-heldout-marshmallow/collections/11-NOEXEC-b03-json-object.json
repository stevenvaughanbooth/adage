        "classification": "opaque_shell",
        "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nvalidator = validate.JsonObject()\n\n# Test valid JSON objects\ntest_cases = [\n    ('{\"a\": 1}', True),\n    ('{}', True),\n    ('{\"nested\": {\"key\": \"value\"}}', True),\n    ('  {\"key\": \"value\"}  ', True),\n    ('[]', False),\n    ('[1, 2, 3]', False),\n    ('\"string\"', False),\n    ('123', False),\n    ('true', False),\n    ('false', False),\n    ('null', False),\n    ('invalid json', False),\n    ('{invalid}', False),\n]\n\nfor test_input, should_pass in test_cases:\n    try:\n        result = validator(test_input)\n        if should_pass:\n            print(f\"\u2713 PASS: {test_input!r}\")\n        else:\n            print(f\"\u2717 FAIL: {test_input!r} should have raised ValidationError\")\n    except ValidationError:\n        if not should_pass:\n            print(f\"\u2713 PASS: {test_input!r} correctly rejected\")\n        else:\n            print(f\"\u2717 FAIL: {test_input!r} should have passed\")\n\n# Test custom error message\nprint(\"\\n--- Testing custom error message ---\")\nvalidator_custom = validate.JsonObject(error=\"Custom: {input}\")\ntry:\n    validator_custom(\"[1, 2]\")\nexcept ValidationError as e:\n    print(f\"Custom error message: {e.messages}\")\nEOF\n",
