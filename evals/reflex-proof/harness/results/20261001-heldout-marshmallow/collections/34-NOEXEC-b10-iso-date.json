        "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\n# Test default error message\nv = validate.IsoDate()\ntry:\n    v(\"invalid-date\")\nexcept ValidationError as e:\n    print(f\"Default error: {e.messages}\")\n\n# Test custom error message with {input} interpolation\nv = validate.IsoDate(error=\"Invalid date: {input}\")\ntry:\n    v(\"not-a-date\")\nexcept ValidationError as e:\n    print(f\"Custom error: {e.messages}\")\n\n# Test valid dates\nprint(f\"Valid: {v('2024-02-29')}\")\nprint(f\"Valid: {v('2024-01-01')}\")\n\n# Test edge cases\ntry:\n    v(\"2024-02-30\")  # Invalid day\nexcept ValidationError as e:\n    print(f\"Invalid day error: {e.messages}\")\n\ntry:\n    v(\"2024-13-01\")  # Invalid month\nexcept ValidationError as e:\n    print(f\"Invalid month error: {e.messages}\")\nEOF\n",
