        "command": ".venv/bin/python << 'EOF'\nfrom marshmallow import validate, ValidationError\n\nv = validate.IsoDate()\n\n# Test leap years\nprint(\"Testing leap years:\")\nprint(f\"2024-02-29 (leap year): {v('2024-02-29')}\")\ntry:\n    v(\"2023-02-29\")  # Not a leap year\nexcept ValidationError:\n    print(\"2023-02-29 (not a leap year): Invalid \u2713\")\n\n# Test century leap year rules (2000 is leap, 1900 is not)\nprint(f\"2000-02-29 (leap year): {v('2000-02-29')}\")\ntry:\n    v(\"1900-02-29\")  # Not a leap year\nexcept ValidationError:\n    print(\"1900-02-29 (not a leap year): Invalid \u2713\")\n\n# Test edge cases for format\ntest_cases = [\n    \"2024-01-01\",  # valid\n    \"2024-12-31\",  # valid\n    \"02024-01-01\",  # Invalid format (too many digits)\n    \"2024-1-01\",  # Invalid format (month too short)\n    \"2024-01-1\",  # Invalid format (day too short)\n    \" 2024-01-01\",  # Invalid (leading space)\n    \"2024-01-01 \",  # Invalid (trailing space)\n    \"2024-01-01T00:00:00\",  # Invalid (with time)\n    \"2024-01-01Z\",  # Invalid (with Z)\n]\n\nprint(\"\\nFormat tests:\")\nfor test in test_cases:\n    try:\n        result = v(test)\n        print(f\"'{test}': Valid \u2713\")\n    except ValidationError:\n        print(f\"'{test}': Invalid \u2713\")\nEOF\n",
