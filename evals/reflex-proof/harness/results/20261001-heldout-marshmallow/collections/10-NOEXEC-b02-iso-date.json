      {
        "adage_pre_context": false,
        "command": ".venv/bin/python -c \"\nfrom marshmallow import validate\n\nvalidator = validate.IsoDate()\n\n# Test various formats\ntest_cases = [\n    ('2024-02-29', True),   # Valid leap year date\n    ('2023-02-28', True),   # Valid non-leap year date\n    ('2024-01-01', True),   # Valid first day of year\n    ('2024-12-31', True),   # Valid last day of year\n    ('20240229', False),    # No dashes\n    ('2024-2-29', False),   # Missing leading zero on month\n    ('2024-02-9', False),   # Missing leading zero on day\n    ('2024/02/29', False),  # Wrong delimiter\n    ('02-29-2024', False),  # Wrong order\n    ('2024-02-29T00:00:00', False),  # With time component\n    ('2024-02-30', False),  # Invalid day for February\n    ('2024-13-01', False),  # Invalid month\n    ('2023-02-29', False),  # Invalid leap year date\n    ('not-a-date', False),  # Not a date at all\n    (None, False),          # Not a string\n    (12345, False),         # Not a string\n]\n\nfor value, should_pass in test_cases:\n    try:\n        result = validator(value)\n        if should_pass:\n            print(f'\u2713 {value!r} passed as expected')\n        else:\n            print(f'\u2717 {value!r} should have failed but passed')\n    except Exception as e:\n        if not should_pass:\n            print(f'\u2713 {value!r} failed as expected')\n        else:\n            print(f'\u2717 {value!r} should have passed but failed: {e}')\n\"\n",
