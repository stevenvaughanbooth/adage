        "command": ".venv/bin/python << 'EOF'\nfrom marshmallow.validate import LatLong\nfrom marshmallow.exceptions import ValidationError\n\nvalidator = LatLong()\n\n# Test valid example\ntry:\n    result = validator((0, 0))\n    print(f\"\u2713 Valid input (0, 0): {result}\")\nexcept ValidationError as e:\n    print(f\"\u2717 Valid input (0, 0) failed: {e}\")\n\n# Test invalid example\ntry:\n    result = validator((91, 0))\n    print(f\"\u2717 Invalid input (91, 0) should have failed but got: {result}\")\nexcept ValidationError as e:\n    print(f\"\u2713 Invalid input (91, 0) correctly raised error: {e}\")\n\n# Test custom error message\nvalidator_custom = LatLong(error=\"Location {input} is out of bounds\")\ntry:\n    result = validator_custom((91, 0))\n    print(f\"\u2717 Custom error test failed\")\nexcept ValidationError as e:\n    print(f\"\u2713 Custom error message: {e}\")\n\n# Test boundary values\nprint(\"\\nBoundary tests:\")\nfor test_case in [(90, 180), (-90, -180), (90, -180), (-90, 180)]:\n    try:\n        result = validator(test_case)\n        print(f\"\u2713 Valid boundary {test_case}: {result}\")\n    except ValidationError:\n        print(f\"\u2717 Boundary {test_case} incorrectly rejected\")\nEOF\n",
