        "adage_pre_context": false,
        "command": ".venv/bin/python -c \"\nfrom marshmallow import validate, ValidationError\n\n# Test basic usage\nv = validate.HasKeys(['id', 'name'])\nresult = v({'id': 1, 'name': 'test'})\nprint('Test 1 - Valid mapping with all keys:', result)\n\n# Test extra keys\nresult = v({'id': 1, 'name': 'test', 'extra': 'field'})\nprint('Test 2 - Valid mapping with extra keys:', result)\n\n# Test missing keys\ntry:\n    v({'id': 1})\n    print('Test 3 - FAILED: Should have raised ValidationError')\nexcept ValidationError as e:\n    print('Test 3 - Missing keys error:', e.messages)\n\n# Test non-mapping\ntry:\n    v([1, 2, 3])\n    print('Test 4 - FAILED: Should have raised ValidationError')\nexcept ValidationError as e:\n    print('Test 4 - Non-mapping error:', e.messages)\n\n# Test custom error message\nv_custom = validate.HasKeys(['id'], error='Missing {keys} in {input}')\ntry:\n    v_custom({'name': 'test'})\nexcept ValidationError as e:\n    print('Test 5 - Custom error:', e.messages)\n\n# Test repr\nprint('Test 6 - Repr:', repr(v))\n\"\n",
