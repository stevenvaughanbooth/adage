+/// Test files named for a source file or for its directory, a weaker signal than [`tests_of`]'s
+/// (a checkout without history has no co-change): a test file whose name has the source's stem
+/// or its directory's name as one of its words (`src/header/name.rs` → `tests/header_map.rs`),
+/// names of at least three characters. Stem matches first, then by path. Procedure cards name
+/// these as where a change's tests live (`crate::cards`); the tests-of-the-edit reflex does not
+/// bind them.
+pub fn nearby(files: &BTreeSet<String>, source: &str) -> Vec<String> {
+    let stem = source_stem(source).to_ascii_lowercase();
+    let dir = source.rsplit('/').nth(1).unwrap_or("").to_ascii_lowercase();
+    let mut out: Vec<(u8, &String)> = Vec::new();
+    for t in files.iter().filter(|f| outcome::is_test_path(f)) {
+        let name = t.rsplit('/').next().unwrap_or(t);
+        let name = name.rsplit_once('.').map_or(name, |x| x.0).to_ascii_lowercase();
+        let words: Vec<&str> = name.split(['_', '.', '-']).collect();
+        let has = |w: &str| w.len() >= 3 && words.contains(&w);
+        if has(&stem) {
+            out.push((0, t));
+        } else if has(&dir) {
+            out.push((1, t));
+        }
+    }
+    out.sort();
+    out.into_iter().map(|(_, t)| t.clone()).collect()
+}
