+++ b/evals/showcase/followup_cardfix.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Post-hoc follow-up to the pre-registered showcase (not part of it): the card-framing fix, Adage arm
+only, on http-header (where the card harmed passes) and mm-validator (the best-saving family).
+See FOLLOWUP-card-framing.md and prereg.json's revision log.
+
+  python3 followup_cardfix.py configs           # write configs/followup-cardfix/<family>.json
+  python3 followup_cardfix.py home --adage BIN  # build each follow-up root's ADAGE_HOME (no spend)
+  python3 followup_cardfix.py analyze           # pair with the showcase's control sessions -> followup-cardfix.json
+
+The index. Each follow-up root's ADAGE_HOME is a copy of the pre-registered root's (the index the
+product learned from the family's same 4 training sessions), with the card re-learned by the new
+binary from those same 4 traces (`adage condition --transcripts <the 4>` into a scratch home):
+  - http-header: the re-learned card is the original byte for byte plus the two new fields
+    (`tests`: tests/header_map.rs, tests/header_map_fuzz.rs; `untested`: true); those fields are
+    written into the copied index.json and the card's track file. Nothing else changes.
+  - mm-validator: the re-learned card is identical to the original (its sessions changed tests, and
+    the tests they changed are among its files), so the copied index is used unchanged.
+Every other route is kept from the original index rather than re-learned: the training checkouts'
+`.venv` was pruned after scoring (sc_score.py), and a re-learn binds environment instincts to
+`uv run` instead of `.venv/bin/python`, a change that is not the fix under test. So the only
+differences from the pre-registered Adage arm are the binary (the card's new first line and tests
+line) and, for http-header, the card's two new fields.
+
+Analysis: the pre-registered estimator (analyze.py: ratio of paired sums, Rao-Wu bootstrap
+clustered by variant, 90%) on (showcase control, follow-up adage) pairs matched by (variant,
+repeat). Controls do not depend on the Adage binary (hooks on, directives withheld).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+SHOWCASE = Path("/tmp/adage-showcase/runs")
+ROOTS = Path("/tmp/adage-cardfix/runs")
+FAMILIES = ["http-header", "mm-validator"]
+CAP = 15.0
+CONFIGS = HERE / "configs" / "followup-cardfix"
+
+
+def configs() -> None:
+    CONFIGS.mkdir(parents=True, exist_ok=True)
+    for f in FAMILIES:
+        cfg = json.loads((HERE / "configs" / f"{f}.json").read_text())
+        cfg["name"] = f"showcase-followup-cardfix-{f}"
+        cfg["description"] = ("Post-hoc follow-up (not pre-registered): the card-framing fix, Adage arm only, "
+                              f"family {f}; paired afterwards with the showcase's control sessions. "
+                              "See evals/showcase/FOLLOWUP-card-framing.md.")
+        cfg["eval"] = {**cfg["eval"], "arms": ["adage"]}
+        cfg["budget_usd"] = 7.5
+        cfg["go_validation"] = {"train_as_user": True, "learner_wait_s": 900, "global_cap_usd": CAP,
+                                "spend_roots": [str(ROOTS / x) for x in FAMILIES]}
+        (CONFIGS / f"{f}.json").write_text(json.dumps(cfg, indent=1) + "\n")
+        print(f"wrote {CONFIGS / f'{f}.json'}")
+
+
+def training_transcripts(f: str) -> list[str]:
+    st = json.loads((SHOWCASE / f / "state.json").read_text())
+    out = []
+    for v in st["runs"].values():
+        if v.get("phase") != "train":
+            continue
+        hits = list((SHOWCASE / f / "private" / "transcripts").glob(f"*/{v['metrics']['session_id']}.jsonl"))
+        assert len(hits) == 1, hits
+        out.append(str(hits[0]))
+    assert len(out) == 4, out
+    return sorted(out)
+
+
+def card_routes(index: dict) -> dict:
+    return {r["route"]["id"]: r for r in index["routes"] if "card" in r["route"]["step"]}
+
+
+def home(adage: str) -> None:
+    rec = {}
+    for f in FAMILIES:
+        cfg = json.loads((HERE / "configs" / f"{f}.json").read_text())
+        src = SHOWCASE / f / "private" / "adage-home"
+        dst = ROOTS / f / "private" / "adage-home"
+        if dst.exists():
+            raise SystemExit(f"{dst} exists; not overwriting")
+        # 1. The card, re-learned by the new binary from the same 4 training traces.
+        with tempfile.TemporaryDirectory() as t:
+            scratch, h = Path(t) / "adage-home", Path(t) / "home"
+            scratch.mkdir()
+            h.mkdir()
+            env = {k: v for k, v in os.environ.items() if k not in ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID")}
+            env.update(ADAGE_HOME=str(scratch), HOME=str(h))
+            out = subprocess.run([adage, "condition", "--json", "--repo", cfg["repo_key"], "--transcripts",
+                                  *training_transcripts(f)], capture_output=True, text=True, env=env, check=True)
+            rep = json.loads(out.stdout)
+            new = card_routes(json.loads((scratch / "index.json").read_text()))
+        old_index = json.loads((src / "index.json").read_text())
+        old = card_routes(old_index)
+        assert sorted(new) == sorted(old), (sorted(new), sorted(old))
+        # 2. A copy of the pre-registered home, with the new card fields.
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copytree(src, dst, symlinks=True, ignore=shutil.ignore_patterns("*.lock"))
+        changed = {}
+        for cid, r in new.items():
+            c_new = r["route"]["step"]["card"]
+            c_old = old[cid]["route"]["step"]["card"]
+            extra = {k: c_new[k] for k in ("tests", "untested") if k in c_new}
+            base_new = {k: v for k, v in c_new.items() if k not in extra}
+            assert base_new == c_old, f"{f}: the re-learned card differs beyond the new fields"
+            if not extra:
+                continue
+            changed[cid] = extra
+            for x in old_index["routes"]:
+                if x["route"]["id"] == cid:
+                    x["route"]["step"]["card"].update(extra)
+            ys = list((dst / "tracks").glob(f"*/learned/routes/{cid}.yaml"))
+            assert len(ys) == 1, ys
+            y = ys[0].read_text()
+            m = re.search(r"^(\s*)prompts:", y, re.M)
+            ind = m.group(1)
+            block = "".join([f"{ind}tests:\n", *[f"{ind}- {t}\n" for t in extra.get("tests", [])],
+                             f"{ind}untested: {'true' if extra.get('untested') else 'false'}\n"])
+            ys[0].write_text(y[:m.start()] + block + y[m.start():])
+        (dst / "index.json").write_text(json.dumps(old_index, indent=1) + "\n")
+        os.chmod(dst / "index.json", 0o600)
+        rec[f] = {"from": str(src), "home": str(dst), "card_fields_added": changed,
+                  "relearn": {k: rep.get(k) for k in ("intent_model", "sessions_used")}}
+        print(f"{f}: {json.dumps(rec[f])}")
+    (ROOTS / "homes.json").write_text(json.dumps(rec, indent=1) + "\n")
+
+
+def analyze(out_path: Path) -> dict:
+    """The pre-registered contrasts (analyze.contrast: ratio of paired sums, Rao-Wu bootstrap clustered
+    by variant, 90%) on (showcase control, follow-up adage) pairs, and for reference the pre-registered
+    (control, adage) pairs of the same family."""
+    sys.path.insert(0, str(HERE))
+    import analyze as an
+    out = {"note": "POST-HOC FOLLOW-UP, not pre-registered: the showcase's control sessions paired by (variant, "
+                   "repeat) with follow-up Adage sessions run with the card-framing fix; see "
+                   "FOLLOWUP-card-framing.md", "families": {}, "spend": {}}
+    for f in FAMILIES:
+        prereg = an.load(SHOWCASE / f)
+        ctl = [s for s in prereg if s["arm"] == "control"]
+        fol = [s for s in an.load(ROOTS / f) if s["arm"] == "adage"]
+        out["families"][f] = {"followup": an.contrast(an.pairs(ctl + fol)), "prereg": an.contrast(an.pairs(prereg))}
+        out["spend"][f] = an.spend(ROOTS / f)
+    out["spend"]["total_usd"] = round(sum(out["spend"][f]["usd"] for f in FAMILIES), 4)
+    out_path.write_text(json.dumps(out, indent=1) + "\n")
+    for f, r in out["families"].items():
+        for k in ("prereg", "followup"):
+            c = r[k]
+            ad, ct = c["arms"]["adage"], c["arms"]["control"]
+            print(f"{f:13s} {k:9s} pairs {c['usd']['pairs']:2d}  usd {c['usd']['change']:+.3f} {c['usd']['ci90']}  "
+                  f"calls {c['calls']['change']:+.3f}  pass adage {ad['pass']['k']}/{ad['pass']['n']} control "
+                  f"{ct['pass']['k']}/{ct['pass']['n']}  diff {c['pass_diff']['diff']:+.3f} {c['pass_diff']['ci90']}  "
+                  f"card {c['card_delivery']['k']}/{c['card_delivery']['n']}  adage check failures {ad['check_failures']}")
+    print("follow-up spend", out["spend"]["total_usd"])
+    return out
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("what", choices=["configs", "home", "analyze"])
+    ap.add_argument("--adage")
+    a = ap.parse_args()
+    if a.what == "configs":
+        configs()
+    elif a.what == "home":
+        home(a.adage or sys.exit("--adage BIN"))
+    else:
+        analyze(HERE / "followup-cardfix.json")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
