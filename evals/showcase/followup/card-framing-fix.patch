+/// A checkout like hyperium/http's: the header table and its re-export, and the tests the project
+/// keeps for them in `tests/` (named for the directory, not the file). No history: the showcase's
+/// sandboxes are one commit, so co-change says nothing.
+fn http_checkout(root: &Path) {
+    for (rel, body) in [
+        ("Cargo.toml", "[package]\nname = \"http\"\n"),
+        ("src/lib.rs", "pub mod header;\n"),
+        ("src/header/mod.rs", "pub use self::name::{ACCEPT, SERVER};\n"),
+        ("src/header/name.rs", "standard_headers! {\n    (Accept, ACCEPT, b\"accept\");\n}\n"),
+        ("src/status.rs", "pub struct StatusCode;\n"),
+        ("tests/header_map.rs", "const STD: &[HeaderName] = &[ACCEPT, SERVER];\n"),
+        ("tests/header_map_fuzz.rs", "const STANDARD_HEADERS: &[HeaderName] = &[header::ACCEPT];\n"),
+        ("tests/status_code.rs", "#[test]\nfn ok() {}\n"),
+    ] {
+        let p = root.join(rel);
+        std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+        std::fs::write(p, body).unwrap();
+    }
+}
