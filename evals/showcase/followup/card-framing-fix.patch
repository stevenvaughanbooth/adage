+/// The showcase's http-header family: every session adds a table entry and the re-export, runs
+/// the unit tests, and writes no test, though each task asked for one (`with_test`: each also adds
+/// a line to `tests/header_map.rs`).
+fn http_corpus(dir: &Path, root: &Path, with_test: bool) -> (Vec<PathBuf>, BTreeMap<String, bool>) {
+    let cwd = root.to_string_lossy().to_string();
+    let mut files = vec![];
+    let mut outcomes = BTreeMap::new();
+    let headers = [("Priority", "PRIORITY"), ("Accept-Patch", "ACCEPT_PATCH"), ("Server-Timing", "SERVER_TIMING")];
+    for (i, (name, konst)) in headers.iter().enumerate() {
+        let sid = format!("h{i}");
+        let mut t = Tx::at(&cwd, &sid, &format!("add a new check rule for the {name} header, with a test"));
+        let entry = format!(
+            "    /// The {name} header.\n    ({}, {konst}, b\"{}\");",
+            name.replace('-', ""),
+            name.to_lowercase()
+        );
+        t.edit("src/header/name.rs", "", &entry).edit("src/header/mod.rs", "", &format!("    {konst},"));
+        if with_test {
+            t.edit("tests/header_map.rs", "", &format!("    {konst},"));
+        }
+        t.bash("cargo test --lib", "test result: ok. 12 passed; 0 failed", false);
+        files.push(t.write(dir));
+        outcomes.insert(sid, true);
+    }
+    (files, outcomes)
+}
